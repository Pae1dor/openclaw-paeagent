{"type":"message","id":"e9231659","parentId":"1de123b1","timestamp":"2026-03-19T08:29:27.183Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_014v7LLo7x8c6QnXbkJJ4ndy","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\components\\WorldChangeTab.tsx","content":"\"use client\";\n\nconst categories = [\"ทั้งหมด\", \"AI & Tech\", \"พลังงาน\", \"ภูมิรัฐศาสตร์\", \"สภาพอากาศ\", \"อวกาศ\"];\n\nconst worldNews = [\n  {\n    title: \"AGI อาจมาถึงเร็วกว่าที่คิด — Anthropic CEO คาดไว้ 2026\",\n    summary: \"Dario Amodei ซีอีโอ Anthropic ให้สัมภาษณ์ว่า Artificial General Intelligence อาจเกิดขึ้นภายใน 1-2 ปีข้างหน้า และมนุษย์ต้องเตรียมพร้อมรับมือการเปลี่ยนแปลงครั้งใหญ่\",\n    category: \"AI & Tech\",\n    impact: \"🌍 เปลี่ยนโลก\",\n    impactColor: \"bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300\",\n    time: \"1 ชั่วโมงที่แล้ว\",\n    source: \"Axios\",\n  },\n  {\n    title: \"จีน-สหรัฐฯ สงครามชิปยกใหม่ — ห้ามส่งออก AI chip รุ่นล่าสุด\",\n    summary: \"รัฐบาลสหรัฐฯ ประกาศมาตรการใหม่ห้ามส่งออก Nvidia H200 และ GB200 ไปจีน ส่งผลกระทบต่อห่วงโซ่อุปทาน AI ทั่วโลก จีนเร่งพัฒนาชิปตัวเองเป็นการตอบโต้\",\n    category: \"ภูมิรัฐศาสตร์\",\n    impact: \"⚡ เร่งด่วน\",\n    impactColor: \"bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300\",\n    time: \"3 ชั่วโมงที่แล้ว\",\n    source: \"WSJ\",\n  },\n  {\n    title: \"พลังงานนิวเคลียร์ฟิวชัน — ITER ทำสถิติใหม่ พร้อม commercial ปี 2035\",\n    summary: \"โครงการ ITER ในฝรั่งเศสสร้างสถิติใหม่ในการรักษาพลาสม่าได้นานที่สุด นักวิทยาศาสตร์เชื่อว่าพลังงานฟิวชันเชิงพาณิชย์อาจเป็นจริงได้ภายในปี 2035\",\n    category: \"พลังงาน\",\n    impact: \"🔮 อนาคต\",\n    impactColor: \"bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300\",\n    time: \"5 ชั่วโมงที่แล้ว\",\n    source: \"Nature\",\n  },\n  {\n    title: \"SpaceX Starship ทำการบินได้สำเร็จ 100% ครั้งแรก\",\n    summary: \"SpaceX ทำการทดสอบ Starship เที่ยวบินที่ 7 สำเร็จสมบูรณ์แบบ ทั้ง launch, orbit, re-entry และ landing ทั้ง 2 ลำ เปิดทางสู่การเดินทางไปดาวอังคาร\",\n    category: \"อวกาศ\",\n    impact: \"🚀 ประวัติศาสตร์\",\n    impactColor: \"bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300\",\n    time: \"6 ชั่วโมงที่แล้ว\",\n    source: \"SpaceX\",\n  },\n  {\n    title: \"อุณหภูมิโลกทำลายสถิติเดือนมีนาคมร้อนที่สุดในประวัติศาสตร์\",\n    summary: \"WMO รายงานอุณหภูมิเฉลี่ยโลกเดือนมีนาคม 2026 สูงกว่าระดับก่อนอุตสาหกรรม 1.6°C นับเป็นเดือนมีนาคมที่ร้อนที่สุดในประวัติศาสตร์การบันทึก\",\n    category: \"สภาพอากาศ\",\n    impact: \"🌡️ วิกฤต\",\n    impactColor: \"bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300\",\n    time: \"8 ชั่วโมงที่แล้ว\",\n    source: \"WMO\",\n  },\n  {\n    title: \"Robotaxi ไร้คนขับ Waymo ขยายไปทุกเมืองใหญ่สหรัฐฯ ปี 2026\",\n    summary: \"Waymo ประกาศแผนขยาย Robotaxi service ครอบคลุม 20 เมืองใหญ่ในสหรัฐฯ ภายในสิ้นปี 2026 นักวิเคราะห์มองว่าจะกระทบอุตสาหกรรมขนส่งและตลาดแรงงานอย่างมีนัยสำคัญ\",\n    category: \"AI & Tech\",\n    impact: \"🌍 เปลี่ยนโลก\",\n    impactColor: \"bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300\",\n    time: \"10 ชั่วโมงที่แล้ว\",\n    source: \"Bloomberg\",\n  },\n  {\n    title: \"BRICS+ ขยายสมาชิกใหม่ 6 ประเทศ — ท้าทายระบบ USD\",\n    summary: \"กลุ่ม BRICS+ ประกาศรับสมาชิกใหม่ 6 ประเทศ พร้อมเดินหน้าพัฒนาสกุลเงินกลางทางเลือกเพื่อลดการพึ่งพา USD ในการค้าระหว่างประเทศ\",\n    category: \"ภูมิรัฐศาสตร์\",\n    impact: \"⚡ เร่งด่วน\",\n    impactColor: \"bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300\",\n    time: \"12 ชั่วโมงที่แล้ว\",\n    source: \"Reuters\",\n  },\n];\n\nconst categoryColors: Record<string, string> = {\n  \"AI & Tech\": \"bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300\",\n  \"พลังงาน\": \"bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300\",\n  \"ภูมิรัฐศาสตร์\": \"bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300\",\n  \"สภาพอากาศ\": \"bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300\",\n  \"อวกาศ\": \"bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300\",\n};\n\nexport default function WorldChangeTab() {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between flex-wrap gap-2\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400\">🌍 การเปลี่ยนแปลงโลก</h2>\n        <span className=\"text-xs text-gray-400\">เทรนด์ที่จะเปลี่ยนชีวิตมึง</span>\n      </div>\n\n      {/* Banner */}\n      <div className=\"bg-gradient-to-r from-indigo-500 to-purple-600 rounded-2xl p-5 text-white\">\n        <p className=\"text-xs opacity-80 mb-1\">🔭 Big Picture</p>\n        <p className=\"font-bold text-lg\">โลกกำลังเปลี่ยนเร็วกว่าที่เคย</p>\n        <p className=\"text-sm opacity-90 mt-1\">AI, พลังงานสะอาด, ภูมิรัฐศาสตร์ใหม่ — ติดตามให้ทัน แล้วมึงจะได้เปรียบ</p>\n      </div>\n\n      {worldNews.map((n, i) => (\n        <div key={i} className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800 hover:shadow-md transition\">\n          <div className=\"flex items-start gap-4\">\n            <div className=\"flex-1\">\n              <div className=\"flex items-center gap-2 mb-2 flex-wrap\">\n                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${categoryColors[n.category] || \"bg-gray-100 text-gray-600\"}`}>\n                  {n.category}\n                </span>\n                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${n.impactColor}`}>\n                  {n.impact}\n                </span>\n              </div>\n              <h3 className=\"font-semibold text-sm mb-1\">{n.title}</h3>\n              <p className=\"text-sm text-gray-500 dark:text-gray-400 leading-relaxed\">{n.summary}</p>\n            </div>\n          </div>\n          <div className=\"flex items-center justify-between mt-3\">\n            <span className=\"text-xs text-gray-400\">{n.source}</span>\n            <span className=\"text-xs text-gray-400\">{n.time}</span>\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":3073,"cacheRead":43365,"cacheWrite":2275,"totalTokens":48714,"cost":{"input":0.000003,"output":0.046095000000000004,"cacheRead":0.0130095,"cacheWrite":0.00853125,"total":0.06763875000000001}},"stopReason":"toolUse","timestamp":1773908918076}}
