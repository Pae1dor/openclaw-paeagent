^1.4.0\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@tailwindcss/postcss\": \"^4\",\r\n    \"@types/node\": \"^20\",\r\n    \"@types/react\": \"^19\",\r\n    \"@types/react-dom\": \"^19\",\r\n    \"eslint\": \"^9\",\r\n    \"eslint-config-next\": \"16.2.0\",\r\n    \"tailwindcss\": \"^4\",\r\n    \"typescript\": \"^5\"\r\n  }\r\n}","cwd":"C:\\Users\\hp\\.openclaw\\workspace"},"isError":false,"timestamp":1773908385285}}
{"type":"message","id":"ff474eb0","parentId":"04a39353","timestamp":"2026-03-19T08:20:18.078Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good - recharts and lucide-react are already installed. Let me write the dashboard page directly.","thinkingSignature":""},{"type":"text","text":"โอเค recharts + lucide ลงแล้ว กูเขียน dashboard เองเลยเร็วกว่า!"},{"type":"toolCall","id":"toolu_01QK5D6LHLf2tdNQJ7ZZmTE6","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\app\\page.tsx","content":"\"use client\";\n\nimport { useState } from \"react\";\nimport {\n  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,\n} from \"recharts\";\nimport { TrendingUp, TrendingDown, BarChart2, DollarSign, Sun, Moon } from \"lucide-react\";\n\n// --- Mock Data ---\nconst portfolioData = Array.from({ length: 30 }, (_, i) => ({\n  day: `${i + 1}`,\n  value: 100000 + Math.floor(Math.sin(i / 3) * 8000 + i * 300 + Math.random() * 2000),\n}));\n\nconst positions = [\n  { symbol: \"NVDA\", qty: 50, avgPrice: 820, currentPrice: 950, sector: \"Tech\" },\n  { symbol: \"AAPL\", qty: 100, avgPrice: 175, currentPrice: 169, sector: \"Tech\" },\n  { symbol: \"PTT.BK\", qty: 5000, avgPrice: 32, currentPrice: 35.5, sector: \"Energy\" },\n  { symbol: \"TSLA\", qty: 30, avgPrice: 250, currentPrice: 178, sector: \"EV\" },\n  { symbol: \"BTC\", qty: 0.5, avgPrice: 55000, currentPrice: 68000, sector: \"Crypto\" },\n];\n\nconst news = [\n  { title: \"Fed คงดอกเบี้ย — ตลาดตอบรับบวก\", time: \"10m ago\", positive: true },\n  { title: \"NVDA ทำ all-time high รอบใหม่\", time: \"1h ago\", positive: true },\n  { title: \"PTT รายงานกำไร Q1 ดีกว่าคาด\", time: \"2h ago\", positive: true },\n  { title: \"TSLA ยอดส่งมอบ Q1 ต่ำกว่าเป้า\", time: \"3h ago\", positive: false },\n];\n\nconst kpis = [\n  {\n    label: \"Portfolio Value\",\n    value: \"฿2,847,500\",\n    change: \"+12.4%\",\n    up: true,\n    icon: DollarSign,\n  },\n  {\n    label: \"Daily P&L\",\n    value: \"+฿18,200\",\n    change: \"+0.64%\",\n    up: true,\n    icon: TrendingUp,\n  },\n  {\n    label: \"Win Rate\",\n    value: \"67.3%\",\n    change: \"+2.1% this month\",\n    up: true,\n    icon: BarChart2,\n  },\n  {\n    label: \"Open Positions\",\n    value: \"5\",\n    change: \"2 in profit\",\n    up: true,\n    icon: TrendingDown,\n  },\n];\n\nexport default function Dashboard() {\n  const [dark, setDark] = useState(false);\n\n  return (\n    <div className={dark ? \"dark\" : \"\"}>\n      <div className=\"min-h-screen bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors\">\n        {/* Navbar */}\n        <nav className=\"flex items-center justify-between px-6 py-4 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-sm\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-2xl\">🦞</span>\n            <span className=\"text-xl font-bold tracking-tight\">ก้ามแดง Dashboard</span>\n          </div>\n          <button\n            onClick={() => setDark(!dark)}\n            className=\"p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition\"\n          >\n            {dark ? <Sun size={20} /> : <Moon size={20} />}\n          </button>\n        </nav>\n\n        <div className=\"p-6 max-w-7xl mx-auto space-y-6\">\n          {/* KPI Cards */}\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n            {kpis.map((k) => (\n              <div key={k.label} className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-sm text-gray-500 dark:text-gray-400\">{k.label}</span>\n                  <k.icon size={18} className=\"text-gray-400\" />\n                </div>\n                <div className=\"text-2xl font-bold\">{k.value}</div>\n                <div className={`text-sm mt-1 ${k.up ? \"text-green-500\" : \"text-red-500\"}`}>{k.change}</div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {/* Chart */}\n            <div className=\"md:col-span-2 bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n              <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">Portfolio Performance (30d)</h2>\n              <ResponsiveContainer width=\"100%\" height={220}>\n                <LineChart data={portfolioData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" stroke={dark ? \"#374151\" : \"#f0f0f0\"} />\n                  <XAxis dataKey=\"day\" tick={{ fontSize: 11 }} stroke=\"#9ca3af\" />\n                  <YAxis tick={{ fontSize: 11 }} stroke=\"#9ca3af\" tickFormatter={(v) => `฿${(v / 1000).toFixed(0)}k`} />\n                  <Tooltip formatter={(v: number) => [`฿${v.toLocaleString()}`, \"Value\"]} />\n                  <Line type=\"monotone\" dataKey=\"value\" stroke=\"#6366f1\" strokeWidth={2} dot={false} />\n                </LineChart>\n              </ResponsiveContainer>\n            </div>\n\n            {/* News */}\n            <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n              <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">📰 News & Alerts</h2>\n              <div className=\"space-y-3\">\n                {news.map((n, i) => (\n                  <div key={i} className=\"flex gap-3 items-start\">\n                    <span className={`mt-1 w-2 h-2 rounded-full flex-shrink-0 ${n.positive ? \"bg-green-400\" : \"bg-red-400\"}`} />\n                    <div>\n                      <p className=\"text-sm leading-snug\">{n.title}</p>\n                      <p className=\"text-xs text-gray-400 mt-0.5\">{n.time}</p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Positions Table */}\n          <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n            <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">📊 Open Positions</h2>\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-sm\">\n                <thead>\n                  <tr className=\"text-left text-gray-400 border-b border-gray-100 dark:border-gray-800\">\n                    <th className=\"pb-2 font-medium\">Symbol</th>\n                    <th className=\"pb-2 font-medium\">Sector</th>\n                    <th className=\"pb-2 font-medium text-right\">Qty</th>\n                    <th className=\"pb-2 font-medium text-right\">Avg Price</th>\n                    <th className=\"pb-2 font-medium text-right\">Current</th>\n                    <th className=\"pb-2 font-medium text-right\">P&L %</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {positions.map((p) => {\n                    const pnl = ((p.currentPrice - p.avgPrice) / p.avgPrice) * 100;\n                    return (\n                      <tr key={p.symbol} className=\"border-b border-gray-50 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50\">\n                        <td className=\"py-3 font-semibold\">{p.symbol}</td>\n                        <td className=\"py-3 text-gray-400\">{p.sector}</td>\n                        <td className=\"py-3 text-right\">{p.qty.toLocaleString()}</td>\n                        <td className=\"py-3 text-right\">{p.avgPrice.toLocaleString()}</td>\n                        <td className=\"py-3 text-right\">{p.currentPrice.toLocaleString()}</td>\n                        <td className={`py-3 text-right font-semibold ${pnl >= 0 ? \"text-green-500\" : \"text-red-500\"}`}>\n                          {pnl >= 0 ? \"+\" : \"\"}{pnl.toFixed(2)}%\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":2754,"cacheRead":27180,"cacheWrite":526,"totalTokens":30461,"cost":{"input":0.000003,"output":0.04131,"cacheRead":0.008154,"cacheWrite":0.0019725,"total":0.051439500000000006}},"stopReason":"toolUse","timestamp":1773908385289}}
