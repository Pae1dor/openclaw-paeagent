{"type":"message","id":"1eb6bee8","parentId":"62cd1b8f","timestamp":"2026-03-19T08:24:43.526Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01YKcEsQbz5158D6b6ceGYRG","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\components\\ForexTab.tsx","content":"\"use client\";\nimport { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, BarChart, Bar } from \"recharts\";\n\nconst pairs = [\n  { pair: \"XAU/USD\", price: 2345.50, change: +12.30, changePct: +0.53, bid: 2345.20, ask: 2345.80, type: \"Gold\" },\n  { pair: \"EUR/USD\", price: 1.0842, change: -0.0021, changePct: -0.19, bid: 1.0841, ask: 1.0843, type: \"Forex\" },\n  { pair: \"GBP/USD\", price: 1.2654, change: +0.0034, changePct: +0.27, bid: 1.2653, ask: 1.2655, type: \"Forex\" },\n  { pair: \"USD/JPY\", price: 151.24, change: +0.43, changePct: +0.28, bid: 151.22, ask: 151.26, type: \"Forex\" },\n  { pair: \"XAG/USD\", price: 27.85, change: +0.15, changePct: +0.54, bid: 27.84, ask: 27.86, type: \"Silver\" },\n  { pair: \"USD/THB\", price: 35.42, change: -0.08, changePct: -0.23, bid: 35.41, ask: 35.43, type: \"Forex\" },\n];\n\nconst goldData = Array.from({ length: 24 }, (_, i) => ({\n  time: `${i}:00`,\n  price: 2330 + Math.floor(Math.sin(i / 4) * 20 + Math.random() * 15),\n}));\n\nconst sessions = [\n  { name: \"Tokyo\", open: \"00:00\", close: \"09:00\", active: false, color: \"bg-red-400\" },\n  { name: \"London\", open: \"08:00\", close: \"17:00\", active: true, color: \"bg-blue-400\" },\n  { name: \"New York\", open: \"13:00\", close: \"22:00\", active: true, color: \"bg-green-400\" },\n];\n\nexport default function ForexTab() {\n  return (\n    <div className=\"space-y-6\">\n      {/* Session Tracker */}\n      <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">🌏 Market Sessions (GMT+7)</h2>\n        <div className=\"flex gap-4 flex-wrap\">\n          {sessions.map((s) => (\n            <div key={s.name} className=\"flex items-center gap-2 bg-gray-50 dark:bg-gray-800 rounded-xl px-4 py-3\">\n              <span className={`w-2.5 h-2.5 rounded-full ${s.color} ${s.active ? \"animate-pulse\" : \"opacity-40\"}`} />\n              <div>\n                <p className=\"font-semibold text-sm\">{s.name}</p>\n                <p className=\"text-xs text-gray-400\">{s.open} – {s.close}</p>\n              </div>\n              <span className={`ml-2 text-xs px-2 py-0.5 rounded-full ${s.active ? \"bg-green-100 text-green-600 dark:bg-green-900 dark:text-green-300\" : \"bg-gray-200 text-gray-400 dark:bg-gray-700\"}`}>\n                {s.active ? \"OPEN\" : \"CLOSED\"}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Gold Chart */}\n      <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-1\">🥇 XAU/USD — Gold (24h)</h2>\n        <p className=\"text-3xl font-bold mb-4\">$2,345.50 <span className=\"text-green-500 text-lg\">+0.53%</span></p>\n        <ResponsiveContainer width=\"100%\" height={200}>\n          <LineChart data={goldData}>\n            <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f0f0f0\" />\n            <XAxis dataKey=\"time\" tick={{ fontSize: 10 }} stroke=\"#9ca3af\" />\n            <YAxis domain={[\"auto\", \"auto\"]} tick={{ fontSize: 10 }} stroke=\"#9ca3af\" />\n            <Tooltip formatter={(v: number) => [`$${v.toFixed(2)}`, \"Gold\"]} />\n            <Line type=\"monotone\" dataKey=\"price\" stroke=\"#f59e0b\" strokeWidth={2} dot={false} />\n          </LineChart>\n        </ResponsiveContainer>\n      </div>\n\n      {/* Pairs Table */}\n      <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">💱 Pairs Watchlist</h2>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"text-left text-gray-400 border-b border-gray-100 dark:border-gray-800\">\n                <th className=\"pb-2 font-medium\">Pair</th>\n                <th className=\"pb-2 font-medium\">Type</th>\n                <th className=\"pb-2 font-medium text-right\">Price</th>\n                <th className=\"pb-2 font-medium text-right\">Change</th>\n                <th className=\"pb-2 font-medium text-right\">Bid</th>\n                <th className=\"pb-2 font-medium text-right\">Ask</th>\n              </tr>\n            </thead>\n            <tbody>\n              {pairs.map((p) => (\n                <tr key={p.pair} className=\"border-b border-gray-50 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50\">\n                  <td className=\"py-3 font-bold\">{p.pair}</td>\n                  <td className=\"py-3\">\n                    <span className=\"text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500\">{p.type}</span>\n                  </td>\n                  <td className=\"py-3 text-right font-mono\">{p.price}</td>\n                  <td className={`py-3 text-right font-semibold ${p.changePct >= 0 ? \"text-green-500\" : \"text-red-500\"}`}>\n                    {p.changePct >= 0 ? \"+\" : \"\"}{p.changePct.toFixed(2)}%\n                  </td>\n                  <td className=\"py-3 text-right font-mono text-gray-400\">{p.bid}</td>\n                  <td className=\"py-3 text-right font-mono text-gray-400\">{p.ask}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":2081,"cacheRead":32282,"cacheWrite":1867,"totalTokens":36231,"cost":{"input":0.000003,"output":0.031215,"cacheRead":0.0096846,"cacheWrite":0.0070012500000000005,"total":0.04790385}},"stopReason":"toolUse","timestamp":1773908661529}}
