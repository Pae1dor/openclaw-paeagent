{"type":"message","id":"e8307f3f","parentId":"e1e672d5","timestamp":"2026-03-19T08:25:12.531Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01AV9Uwgo1VjURs5kvRrL6yR","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\components\\ExpenseTab.tsx","content":"\"use client\";\nimport { useState } from \"react\";\nimport { PieChart, Pie, Cell, Tooltip, ResponsiveContainer } from \"recharts\";\nimport { Plus, Trash2 } from \"lucide-react\";\n\ntype Entry = { id: number; desc: string; amount: number; type: \"income\" | \"expense\"; category: string; date: string };\n\nconst COLORS = [\"#6366f1\", \"#f59e0b\", \"#10b981\", \"#ef4444\", \"#8b5cf6\", \"#06b6d4\"];\n\nconst initData: Entry[] = [\n  { id: 1, desc: \"เงินเดือน\", amount: 45000, type: \"income\", category: \"เงินเดือน\", date: \"2026-03-01\" },\n  { id: 2, desc: \"กำไรเทรด\", amount: 18200, type: \"income\", category: \"เทรด\", date: \"2026-03-15\" },\n  { id: 3, desc: \"ค่าเช่า\", amount: 8000, type: \"expense\", category: \"ที่พัก\", date: \"2026-03-01\" },\n  { id: 4, desc: \"ค่าอาหาร\", amount: 4500, type: \"expense\", category: \"อาหาร\", date: \"2026-03-10\" },\n  { id: 5, desc: \"ค่า Netflix/Spotify\", amount: 450, type: \"expense\", category: \"บันเทิง\", date: \"2026-03-05\" },\n  { id: 6, desc: \"ค่าน้ำมัน\", amount: 1200, type: \"expense\", category: \"เดินทาง\", date: \"2026-03-12\" },\n];\n\nexport default function ExpenseTab() {\n  const [entries, setEntries] = useState<Entry[]>(initData);\n  const [desc, setDesc] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [type, setType] = useState<\"income\" | \"expense\">(\"expense\");\n  const [category, setCategory] = useState(\"อื่นๆ\");\n\n  const totalIncome = entries.filter(e => e.type === \"income\").reduce((s, e) => s + e.amount, 0);\n  const totalExpense = entries.filter(e => e.type === \"expense\").reduce((s, e) => s + e.amount, 0);\n  const balance = totalIncome - totalExpense;\n\n  const expenseByCategory = entries\n    .filter(e => e.type === \"expense\")\n    .reduce((acc: Record<string, number>, e) => {\n      acc[e.category] = (acc[e.category] || 0) + e.amount;\n      return acc;\n    }, {});\n\n  const pieData = Object.entries(expenseByCategory).map(([name, value]) => ({ name, value }));\n\n  const addEntry = () => {\n    if (!desc || !amount) return;\n    setEntries([...entries, {\n      id: Date.now(), desc, amount: parseFloat(amount), type, category,\n      date: new Date().toISOString().split(\"T\")[0],\n    }]);\n    setDesc(\"\"); setAmount(\"\");\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Summary Cards */}\n      <div className=\"grid grid-cols-3 gap-4\">\n        {[\n          { label: \"รายรับ\", value: totalIncome, color: \"text-green-500\" },\n          { label: \"รายจ่าย\", value: totalExpense, color: \"text-red-500\" },\n          { label: \"คงเหลือ\", value: balance, color: balance >= 0 ? \"text-blue-500\" : \"text-red-500\" },\n        ].map((c) => (\n          <div key={c.label} className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800 text-center\">\n            <p className=\"text-sm text-gray-400 mb-1\">{c.label}</p>\n            <p className={`text-2xl font-bold ${c.color}`}>฿{c.value.toLocaleString()}</p>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Pie Chart */}\n        <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n          <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">📊 รายจ่ายตามหมวด</h2>\n          <ResponsiveContainer width=\"100%\" height={200}>\n            <PieChart>\n              <Pie data={pieData} cx=\"50%\" cy=\"50%\" outerRadius={80} dataKey=\"value\" label={({ name, percent }) => `${name} ${(percent * 100).toFixed(0)}%`}>\n                {pieData.map((_, i) => <Cell key={i} fill={COLORS[i % COLORS.length]} />)}\n              </Pie>\n              <Tooltip formatter={(v: number) => `฿${v.toLocaleString()}`} />\n            </PieChart>\n          </ResponsiveContainer>\n        </div>\n\n        {/* Add Entry Form */}\n        <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n          <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">➕ เพิ่มรายการ</h2>\n          <div className=\"space-y-3\">\n            <input\n              className=\"w-full border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-2 text-sm bg-gray-50 dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n              placeholder=\"รายละเอียด\"\n              value={desc}\n              onChange={e => setDesc(e.target.value)}\n            />\n            <input\n              className=\"w-full border border-gray-200 dark:border-gray-700 rounded-xl px-4 py-2 text-sm bg-gray-50 dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n              placeholder=\"จำนวนเงิน\"\n              type=\"number\"\n              value={amount}\n              onChange={e => setAmount(e.target.value)}\n            />\n            <div className=\"flex gap-2\">\n              <select\n                className=\"flex-1 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2 text-sm bg-gray-50 dark:bg-gray-800 focus:outline-none\"\n                value={type}\n                onChange={e => setType(e.target.value as \"income\" | \"expense\")}\n              >\n                <option value=\"income\">รายรับ</option>\n                <option value=\"expense\">รายจ่าย</option>\n              </select>\n              <input\n                className=\"flex-1 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2 text-sm bg-gray-50 dark:bg-gray-800 focus:outline-none\"\n                placeholder=\"หมวดหมู่\"\n                value={category}\n                onChange={e => setCategory(e.target.value)}\n              />\n            </div>\n            <button\n              onClick={addEntry}\n              className=\"w-full bg-indigo-500 hover:bg-indigo-600 text-white rounded-xl py-2 text-sm font-semibold flex items-center justify-center gap-2 transition\"\n            >\n              <Plus size={16} /> เพิ่มรายการ\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Transactions List */}\n      <div className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400 mb-4\">📋 รายการทั้งหมด</h2>\n        <div className=\"space-y-2\">\n          {entries.slice().reverse().map((e) => (\n            <div key={e.id} className=\"flex items-center justify-between py-2 border-b border-gray-50 dark:border-gray-800\">\n              <div className=\"flex items-center gap-3\">\n                <span className={`text-lg ${e.type === \"income\" ? \"text-green-500\" : \"text-red-500\"}`}>\n                  {e.type === \"income\" ? \"↑\" : \"↓\"}\n                </span>\n                <div>\n                  <p className=\"text-sm font-medium\">{e.desc}</p>\n                  <p className=\"text-xs text-gray-400\">{e.category} · {e.date}</p>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <span className={`font-semibold ${e.type === \"income\" ? \"text-green-500\" : \"text-red-500\"}`}>\n                  {e.type === \"income\" ? \"+\" : \"-\"}฿{e.amount.toLocaleString()}\n                </span>\n                <button onClick={() => setEntries(entries.filter(x => x.id !== e.id))} className=\"text-gray-300 hover:text-red-400 transition\">\n                  <Trash2 size={15} />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":2674,"cacheRead":34149,"cacheWrite":2118,"totalTokens":38942,"cost":{"input":0.000003,"output":0.04011,"cacheRead":0.010244699999999999,"cacheWrite":0.0079425,"total":0.0583002}},"stopReason":"toolUse","timestamp":1773908683535}}
