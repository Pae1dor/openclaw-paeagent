{"type":"message","id":"06d367cb","parentId":"bb66b868","timestamp":"2026-03-19T08:26:01.309Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01EtmbB8M19r774jPbS8pTw4","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\app\\page.tsx","content":"\"use client\";\n\nimport { useState } from \"react\";\nimport { Sun, Moon } from \"lucide-react\";\nimport StocksTab from \"@/components/StocksTab\";\nimport ForexTab from \"@/components/ForexTab\";\nimport ExpenseTab from \"@/components/ExpenseTab\";\nimport NewsTab from \"@/components/NewsTab\";\n\nconst tabs = [\n  { id: \"stocks\", label: \"📈 หุ้น\" },\n  { id: \"forex\", label: \"🥇 ทอง / Forex\" },\n  { id: \"expense\", label: \"💰 รายรับ-รายจ่าย\" },\n  { id: \"news\", label: \"📰 ข่าว\" },\n];\n\nexport default function Dashboard() {\n  const [dark, setDark] = useState(false);\n  const [activeTab, setActiveTab] = useState(\"stocks\");\n\n  return (\n    <div className={dark ? \"dark\" : \"\"}>\n      <div className=\"min-h-screen bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors\">\n        {/* Navbar */}\n        <nav className=\"flex items-center justify-between px-6 py-4 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-sm sticky top-0 z-10\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-2xl\">🦞</span>\n            <span className=\"text-xl font-bold tracking-tight\">ก้ามแดง Dashboard</span>\n          </div>\n          <button\n            onClick={() => setDark(!dark)}\n            className=\"p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition\"\n          >\n            {dark ? <Sun size={20} /> : <Moon size={20} />}\n          </button>\n        </nav>\n\n        {/* Tabs */}\n        <div className=\"px-6 pt-4 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800\">\n          <div className=\"flex gap-1 overflow-x-auto\">\n            {tabs.map((t) => (\n              <button\n                key={t.id}\n                onClick={() => setActiveTab(t.id)}\n                className={`px-4 py-2.5 text-sm font-medium rounded-t-xl whitespace-nowrap transition-colors ${\n                  activeTab === t.id\n                    ? \"bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-300 border-b-2 border-indigo-500\"\n                    : \"text-gray-500 hover:text-gray-700 dark:hover:text-gray-300\"\n                }`}\n              >\n                {t.label}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 max-w-7xl mx-auto\">\n          {activeTab === \"stocks\" && <StocksTab />}\n          {activeTab === \"forex\" && <ForexTab />}\n          {activeTab === \"expense\" && <ExpenseTab />}\n          {activeTab === \"news\" && <NewsTab />}\n        </div>\n      </div>\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":954,"cacheRead":38978,"cacheWrite":2140,"totalTokens":42073,"cost":{"input":0.000003,"output":0.01431,"cacheRead":0.0116934,"cacheWrite":0.008025000000000001,"total":0.0340314}},"stopReason":"toolUse","timestamp":1773908748829}}
