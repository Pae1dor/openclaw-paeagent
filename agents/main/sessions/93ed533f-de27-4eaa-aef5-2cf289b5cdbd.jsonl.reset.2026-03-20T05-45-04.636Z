{"type":"message","id":"cd1993c9","parentId":"1d3804c8","timestamp":"2026-03-19T08:25:48.818Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01Eznp2rpt8ifHnM1fE3vJS8","name":"write","arguments":{"file_path":"C:\\Users\\hp\\Projects\\dashboard\\components\\NewsTab.tsx","content":"\"use client\";\n\nconst newsItems = [\n  {\n    title: \"Fed คงดอกเบี้ยที่ 5.25% — ส่งสัญญาณลดปลายปี\",\n    summary: \"ธนาคารกลางสหรัฐฯ มีมติคงดอกเบี้ยในการประชุมเดือนมีนาคม พร้อมส่งสัญญาณว่าอาจลดดอกเบี้ย 2-3 ครั้งในปีนี้ หากเงินเฟ้อลดลงตามเป้า\",\n    tag: \"Fed/ดอกเบี้ย\",\n    impact: \"bullish\",\n    asset: \"หุ้น / ทอง\",\n    time: \"10 นาทีที่แล้ว\",\n    source: \"Reuters\",\n  },\n  {\n    title: \"ทองคำแตะ $2,345 — นักลงทุนแห่ซื้อ safe haven\",\n    summary: \"ราคาทองคำโลกพุ่งขึ้นหลังตัวเลขเงินเฟ้อสหรัฐฯ ออกมาสูงกว่าคาด นักวิเคราะห์มองเป้าหมายต่อไปที่ $2,400\",\n    tag: \"XAU/USD\",\n    impact: \"bullish\",\n    asset: \"ทอง\",\n    time: \"1 ชั่วโมงที่แล้ว\",\n    source: \"Bloomberg\",\n  },\n  {\n    title: \"SET Index ปรับตัวขึ้น — กลุ่มพลังงานนำตลาด\",\n    summary: \"ตลาดหุ้นไทยปิดบวก 8 จุด หุ้นกลุ่มพลังงานอย่าง PTT และ PTTEP ขึ้นนำตลาดหลังราคาน้ำมันดิบปรับตัวสูงขึ้น\",\n    tag: \"SET/Thailand\",\n    impact: \"bullish\",\n    asset: \"หุ้นไทย\",\n    time: \"2 ชั่วโมงที่แล้ว\",\n    source: \"Krungsri\",\n  },\n  {\n    title: \"TSLA ยอดส่งมอบ Q1 ต่ำกว่าเป้า — หุ้นดิ่ง 5%\",\n    summary: \"Tesla รายงานยอดส่งมอบรถ Q1/2026 ที่ 386,810 คัน ต่ำกว่าคาดการณ์ที่ 408,000 คัน ส่งผลให้หุ้นร่วงหนักในตลาด after-hours\",\n    tag: \"TSLA\",\n    impact: \"bearish\",\n    asset: \"TSLA\",\n    time: \"3 ชั่วโมงที่แล้ว\",\n    source: \"CNBC\",\n  },\n  {\n    title: \"Bitcoin ทดสอบ $70,000 อีกครั้ง — Halving ใกล้เข้ามา\",\n    summary: \"BTC ปรับตัวขึ้นใกล้แนวต้าน $70,000 นักลงทุนจับตา Bitcoin Halving ที่คาดว่าจะเกิดขึ้นในเดือนเมษายนนี้\",\n    tag: \"BTC/Crypto\",\n    impact: \"bullish\",\n    asset: \"Crypto\",\n    time: \"4 ชั่วโมงที่แล้ว\",\n    source: \"CoinDesk\",\n  },\n  {\n    title: \"EUR/USD อ่อนค่า — ตัวเลข PMI ยูโรโซนต่ำกว่าคาด\",\n    summary: \"ค่าเงินยูโรอ่อนค่าลงหลังตัวเลข PMI ภาคบริการยูโรโซนออกมาที่ 49.3 ต่ำกว่าระดับ 50 เป็นครั้งแรกในรอบ 3 เดือน\",\n    tag: \"EUR/USD\",\n    impact: \"bearish\",\n    asset: \"Forex\",\n    time: \"5 ชั่วโมงที่แล้ว\",\n    source: \"FX Street\",\n  },\n];\n\nconst impactColor: Record<string, string> = {\n  bullish: \"bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300\",\n  bearish: \"bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300\",\n  neutral: \"bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400\",\n};\n\nexport default function NewsTab() {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-sm font-semibold text-gray-500 dark:text-gray-400\">📰 ข่าวที่มีผลต่อพอร์ตมึง</h2>\n        <span className=\"text-xs text-gray-400\">อัปเดตล่าสุด: เมื่อกี้</span>\n      </div>\n\n      {newsItems.map((n, i) => (\n        <div key={i} className=\"bg-white dark:bg-gray-900 rounded-2xl p-5 shadow-sm border border-gray-100 dark:border-gray-800 hover:shadow-md transition\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div className=\"flex-1\">\n              <div className=\"flex items-center gap-2 mb-2 flex-wrap\">\n                <span className=\"text-xs px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300 font-medium\">\n                  {n.tag}\n                </span>\n                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${impactColor[n.impact]}`}>\n                  {n.impact === \"bullish\" ? \"🟢 Bullish\" : n.impact === \"bearish\" ? \"🔴 Bearish\" : \"⚪ Neutral\"}\n                </span>\n                <span className=\"text-xs text-gray-400\">กระทบ: {n.asset}</span>\n              </div>\n              <h3 className=\"font-semibold text-sm mb-1\">{n.title}</h3>\n              <p className=\"text-sm text-gray-500 dark:text-gray-400 leading-relaxed\">{n.summary}</p>\n            </div>\n          </div>\n          <div className=\"flex items-center justify-between mt-3\">\n            <span className=\"text-xs text-gray-400\">{n.source}</span>\n            <span className=\"text-xs text-gray-400\">{n.time}</span>\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":2104,"cacheRead":36267,"cacheWrite":2711,"totalTokens":41083,"cost":{"input":0.000003,"output":0.03156,"cacheRead":0.0108801,"cacheWrite":0.01016625,"total":0.05260935}},"stopReason":"toolUse","timestamp":1773908712541}}
