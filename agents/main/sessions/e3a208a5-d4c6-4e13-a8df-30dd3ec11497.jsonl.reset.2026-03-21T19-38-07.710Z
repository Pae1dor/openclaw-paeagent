{"type":"message","id":"850679c8","parentId":"d1585270","timestamp":"2026-03-20T08:01:34.590Z","message":{"role":"toolResult","toolCallId":"toolu_01L2Wsbn2YuWY8WgzK5maPMG","toolName":"read","content":[{"type":"text","text":"        .stat-label {\n            font-size: 0.9rem;\n            opacity: 0.8;\n        }\n        \n        .profit {\n            color: #06d6a0;\n        }\n        \n        .loss {\n            color: #ef476f;\n        }\n        \n        .neutral {\n            color: #ffd166;\n        }\n        \n        .chart-container {\n            height: 300px;\n            margin-top: 15px;\n        }\n        \n        table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 15px;\n        }\n        \n        th, td {\n            padding: 12px 15px;\n            text-align: left;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        \n        th {\n            background: rgba(255, 255, 255, 0.08);\n            color: #4ecdc4;\n            font-weight: 600;\n        }\n        \n        tr:hover {\n            background: rgba(255, 255, 255, 0.03);\n        }\n        \n        .strategy-badges {\n            display: flex;\n            gap: 10px;\n            flex-wrap: wrap;\n            margin-top: 20px;\n        }\n        \n        .badge {\n            padding: 8px 16px;\n            border-radius: 20px;\n            font-size: 0.9rem;\n            font-weight: 500;\n        }\n        \n        .badge.scalp {\n            background: rgba(239, 71, 111, 0.2);\n            color: #ef476f;\n            border: 1px solid #ef476f;\n        }\n        \n        .badge.trend {\n            background: rgba(6, 214, 160, 0.2);\n            color: #06d6a0;\n            border: 1px solid #06d6a0;\n        }\n        \n        .badge.breakout {\n            background: rgba(255, 209, 102, 0.2);\n            color: #ffd166;\n            border: 1px solid #ffd166;\n        }\n        \n        .loading {\n            text-align: center;\n            padding: 40px;\n            font-size: 1.2rem;\n            color: #ffd166;\n        }\n        \n        .error {\n            text-align: center;\n            padding: 40px;\n            color: #ef476f;\n            background: rgba(239, 71, 111, 0.1);\n            border-radius: 10px;\n            margin: 20px 0;\n        }\n        \n        .refresh-btn {\n            background: #4ecdc4;\n            color: white;\n            border: none;\n            padding: 10px 20px;\n            border-radius: 8px;\n            cursor: pointer;\n            font-size: 1rem;\n            margin-top: 20px;\n            transition: background 0.3s ease;\n        }\n        \n        .refresh-btn:hover {\n            background: #3db4ab;\n        }\n        \n        footer {\n            text-align: center;\n            margin-top: 40px;\n            padding: 20px;\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.9rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        \n        @media (max-width: 768px) {\n            .dashboard-grid {\n                grid-template-columns: 1fr;\n            }\n            \n            .stats-grid {\n                grid-template-columns: 1fr;\n            }\n            \n            h1 {\n                font-size: 2rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>🦞 ก้ามแดง Dashboard</h1>\n            <div class=\"subtitle\">ผลเทรด GoldHunter EA - XAUUSD</div>\n            <div class=\"last-update\" id=\"lastUpdate\">กำลังโหลดข้อมูล...</div>\n        </header>\n        \n        <div class=\"tabs\">\n            <button class=\"tab active\" onclick=\"switchTab('overview')\">ภาพรวม</button>\n            <button class=\"tab\" onclick=\"switchTab('performance')\">ประสิทธิภาพ</button>\n            <button class=\"tab\" onclick=\"switchTab('history')\">ประวัติการเทรด</button>\n            <button class=\"tab\" onclick=\"switchTab('strategies')\">กลยุทธ์</button>\n        </div>\n        \n        <!-- Tab 1: Overview -->\n        <div id=\"overview\" class=\"tab-content active\">\n            <div class=\"dashboard-grid\">\n                <div class=\"card\">\n                    <h3>💰 สรุปผลวันนี้</h3>\n                    <div class=\"stats-grid\">\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">กำไร/ขาดทุน</div>\n                            <div class=\"stat-value\" id=\"todayPL\">$0.00</div>\n                            <div class=\"stat-label\" id=\"todayPLChange\">+0.00%</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">จำนวนเทรด</div>\n                            <div class=\"stat-value\" id=\"todayTrades\">0</div>\n                            <div class=\"stat-label\">วันนี้</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">Win Rate</div>\n                            <div class=\"stat-value\" id=\"todayWinRate\">0%</div>\n                            <div class=\"stat-label\">อัตราชนะ</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">Balance</div>\n                            <div class=\"stat-value\" id=\"todayBalance\">$0.00</div>\n                            <div class=\"stat-label\">ยอดคงเหลือ</div>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📈 Equity Curve</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"equityChart\"></canvas>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>🎯 กลยุทธ์ล่าสุด</h3>\n                    <div id=\"currentStrategy\" class=\"stat-value neutral\">UNKNOWN</div>\n                    <div class=\"stat-label\">กลยุทธ์ที่ใช้งาน</div>\n                    \n                    <div class=\"strategy-badges\">\n                        <div class=\"badge scalp\">SCALP</div>\n                        <div class=\"badge trend\">TREND</div>\n                        <div class=\"badge breakout\">BREAKOUT</div>\n                    </div>\n                    \n                    <div style=\"margin-top: 20px;\">\n                        <div class=\"stat-label\">สถานะล่าสุด:</div>\n                        <div id=\"lastStatus\" style=\"margin-top: 5px; font-size: 0.9rem; opacity: 0.9;\">กำลังโหลด...</div>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📊 สถิติสะสม</h3>\n                    <div class=\"stats-grid\">\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">เทรดทั้งหมด</div>\n                            <div class=\"stat-value\" id=\"totalTrades\">0</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">ชนะทั้งหมด</div>\n                            <div class=\"stat-value profit\" id=\"totalWins\">0</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">แพ้ทั้งหมด</div>\n                            <div class=\"stat-value loss\" id=\"totalLosses\">0</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-label\">กำไรสะสม</div>\n                            <div class=\"stat-value\" id=\"totalPL\">$0.00</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Tab 2: Performance -->\n        <div id=\"performance\" class=\"tab-content\">\n            <div class=\"dashboard-grid\">\n                <div class=\"card\">\n                    <h3>📊 P&L รายวัน</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"dailyPLChart\"></canvas>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📈 Win Rate รายวัน</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"winRateChart\"></canvas>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📉 Drawdown</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"drawdownChart\"></canvas>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📋 สถิติประสิทธิภาพ</h3>\n                    <table>\n                        <tr>\n                            <td>Average Win</td>\n                            <td id=\"avgWin\">$0.00</td>\n                        </tr>\n                        <tr>\n                            <td>Average Loss</td>\n                            <td id=\"avgLoss\">$0.00</td>\n                        </tr>\n                        <tr>\n                            <td>Profit Factor</td>\n                            <td id=\"profitFactor\">0.00</td>\n                        </tr>\n                        <tr>\n                            <td>Max Consecutive Wins</td>\n                            <td id=\"maxConsecutiveWins\">0</td>\n                        </tr>\n                        <tr>\n                            <td>Max Consecutive Losses</td>\n                            <td id=\"maxConsecutiveLosses\">0</td>\n                        </tr>\n                    </table>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Tab 3: History -->\n        <div id=\"history\" class=\"tab-content\">\n            <div class=\"card\">\n                <h3>📝 ประวัติการเทรดล่าสุด</h3>\n                <div class=\"chart-container\">\n                    <table id=\"tradeHistory\">\n                        <thead>\n                            <tr>\n                                <th>วันที่</th>\n                                <th>เทรด</th>\n                                <th>ชนะ</th>\n                                <th>แพ้</th>\n                                <th>P&L</th>\n                                <th>Win Rate</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"tradeHistoryBody\">\n                            <!-- ข้อมูลจะถูกเพิ่มโดย JavaScript -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Tab 4: Strategies -->\n        <div id=\"strategies\" class=\"tab-content\">\n            <div class=\"dashboard-grid\">\n                <div class=\"card\">\n                    <h3>🎯 ผลลัพธ์ตามกลยุทธ์</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"strategyChart\"></canvas>\n                    </div>\n                </div>\n                \n                <div class=\"card\">\n                    <h3>📊 สถิติกลยุทธ์</h3>\n                    <table id=\"strategyTable\">\n                        <thead>\n                            <tr>\n                                <th>กลยุทธ์</th>\n                                <th>เทรด</th>\n                                <th>Win Rate</th>\n                                <th>P&L</th>\n                                <th>ประสิทธิภาพ</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"strategyTableBody\">\n                            <!-- ข้อมูลจะถูกเพิ่มโดย JavaScript -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n        \n        <div style=\"text-align: center; margin-top: 30px;\">\n            <button class=\"refresh-btn\" onclick=\"loadData()\">\n                🔄 โหลดข้อมูลใหม่\n            </button>\n        </div>\n        \n        <footer>\n            <p>Dashboard ก้ามแดง • GoldHunter EA v3.0 • XAUUSD</p>\n            <p>อัพเดทอัตโนมัติทุกวันเวลา 22:00 น. (เวลาไทย)</p>\n            <p>© 2026 ก้ามแดง AI Assistant</p>\n        </footer>\n    </div>\n    \n    <script>\n        // ตัวแปรเก็บข้อมูล\n        let tradingData = null;\n        let equityChart = null;\n        let dailyPLChart = null;\n        let winRateChart = null;\n        let drawdownChart = null;\n        let strategyChart = null;\n        \n        // ฟังก์ชันเปลี่ยนแท็บ\n        function switchTab(tabName) {\n            // ซ่อนแท็บทั้งหมด\n            document.querySelectorAll('.tab-content').forEach(tab => {\n                tab.classList.remove('active');\n            });\n            \n            // ลบ active จากปุ่มแท็บทั้งหมด\n            document.querySelectorAll('.tab').forEach(btn => {\n                btn.classList.remove('active');\n            });\n            \n            // แสดงแท็บที่เลือก\n            document.getElementById(tabName).classList.add('active');\n            \n            // ตั้งค่า active ให้ปุ่ม\n            document.querySelector(`.tab[onclick=\"switchTab('${tabName}')\"]`"}],"isError":false,"timestamp":1773993694583}}
{"type":"message","id":"264493e7","parentId":"850679c8","timestamp":"2026-03-20T08:01:50.196Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I can see the full HTML dashboard file. It's a nice dark-themed dashboard. Now I need to understand what the user wants - they want to restore this dashboard but with 4 tabs:\n1. ข่าวเศรษฐกิจ (Economic news)\n2. รายรับรายจ่าย (Income/Expense)\n3. หุ้น (Stocks)\n4. เทรดทอง (Gold trading - the existing GoldHunter dashboard)\n\nThe existing file is a pure HTML file that reads from a JSON file. The issue is it needs a server to serve the data. \n\nSo I need to create a new Express server with an index.html file that combines all 4 tabs using the same dark theme styling, with API routes to handle the news, income/expense, stocks, and gold trading data.","thinkingSignature":""},{"type":"text","text":"ได้เลย! เห็นของเดิมแล้ว สวยมากเลย dark theme สีแดง-เขียว-ทอง สร้างใหม่ที่ `localhost:3001` โดยเอาสไตล์นี้มาใช้ แล้วขยายเป็น 4 แท็บ\n\nสร้างทั้งหมดในครั้งเดียวเลย:"},{"type":"toolCall","id":"toolu_018JCjx713gcWnqXfXZBtSS4","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\package.json","content":"{\n  \"name\": \"kamdaeng-dashboard\",\n  \"version\": \"1.0.0\",\n  \"description\": \"ก้ามแดง Dashboard\",\n  \"main\": \"server.js\",\n  \"scripts\": {\n    \"start\": \"node server.js\",\n    \"dev\": \"node server.js\"\n  },\n  \"dependencies\": {\n    \"express\": \"^4.18.2\"\n  }\n}\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":653,"cacheRead":63672,"cacheWrite":3974,"totalTokens":68300,"cost":{"input":0.000003,"output":0.009795,"cacheRead":0.0191016,"cacheWrite":0.0149025,"total":0.0438021}},"stopReason":"toolUse","timestamp":1773993694595}}
{"type":"message","id":"4c8afd73","parentId":"264493e7","timestamp":"2026-03-20T08:01:50.323Z","message":{"role":"toolResult","toolCallId":"toolu_018JCjx713gcWnqXfXZBtSS4","toolName":"write","content":[{"type":"text","text":"Successfully wrote 247 bytes to C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\package.json"}],"isError":false,"timestamp":1773993710315}}
{"type":"message","id":"df0515a5","parentId":"4c8afd73","timestamp":"2026-03-20T08:02:02.457Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_018W8BLsAzvxQjAzcJYZqZgi","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\server.js","content":"const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\nconst https = require('https');\n\nconst app = express();\nconst PORT = 3001;\n\napp.use(express.static(path.join(__dirname, 'public')));\n\n// ─── API: Gold Trading ─────────────────────────────────────────────────────\napp.get('/api/gold', (req, res) => {\n  const dataPath = 'C:\\\\Users\\\\hp\\\\.openclaw\\\\workspace\\\\goldhunter_data.json';\n  try {\n    if (!fs.existsSync(dataPath)) {\n      return res.json({ success: false, error: 'ยังไม่มีข้อมูล - รัน update_goldhunter_data.py ก่อน' });\n    }\n    const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));\n    res.json({ success: true, data });\n  } catch (e) {\n    res.json({ success: false, error: e.message });\n  }\n});\n\n// ─── API: News ─────────────────────────────────────────────────────────────\napp.get('/api/news', (req, res) => {\n  const url = 'https://feeds.bbci.co.uk/news/business/rss.xml';\n  https.get(url, { headers: { 'User-Agent': 'Mozilla/5.0' } }, (response) => {\n    let raw = '';\n    response.on('data', c => raw += c);\n    response.on('end', () => {\n      const items = [];\n      const blocks = raw.match(/<item>([\\s\\S]*?)<\\/item>/g) || [];\n      for (const b of blocks.slice(0, 12)) {\n        const title = (b.match(/<title><!\\[CDATA\\[(.*?)\\]\\]>/) || b.match(/<title>(.*?)<\\/title>/) || [])[1] || '';\n        const link  = (b.match(/<link>(.*?)<\\/link>/) || [])[1] || '#';\n        const date  = (b.match(/<pubDate>(.*?)<\\/pubDate>/) || [])[1] || '';\n        const desc  = (b.match(/<description><!\\[CDATA\\[(.*?)\\]\\]>/) || b.match(/<description>(.*?)<\\/description>/) || [])[1] || '';\n        if (title) items.push({ title: title.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>'), link, date, desc: desc.replace(/<[^>]*>/g,'').substring(0,200) });\n      }\n      res.json({ success: true, items });\n    });\n  }).on('error', e => res.json({ success: false, error: e.message, items: [] }));\n});\n\napp.get('/', (req, res) => res.sendFile(path.join(__dirname, 'public', 'index.html')));\n\napp.listen(PORT, () => console.log(`🦞 ก้ามแดง Dashboard → http://localhost:${PORT}`));\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":879,"cacheRead":67646,"cacheWrite":354,"totalTokens":68880,"cost":{"input":0.000003,"output":0.013185,"cacheRead":0.0202938,"cacheWrite":0.0013275000000000001,"total":0.0348093}},"stopReason":"toolUse","timestamp":1773993710327}}
{"type":"message","id":"f379f942","parentId":"df0515a5","timestamp":"2026-03-20T08:02:02.472Z","message":{"role":"toolResult","toolCallId":"toolu_018W8BLsAzvxQjAzcJYZqZgi","toolName":"write","content":[{"type":"text","text":"Successfully wrote 2140 bytes to C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\server.js"}],"isError":false,"timestamp":1773993722467}}
{"type":"message","id":"0a006e5a","parentId":"f379f942","timestamp":"2026-03-20T08:03:45.168Z","message":{"role":"assistant","content":[{"type":"text","text":"ตอนนี้สร้าง HTML หลัก — เอา style เดิมมาต่อยอด:"},{"type":"toolCall","id":"toolu_011k9eURDoXtredikjgvNBrV","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\public\\index.html","content":"<!DOCTYPE html>\n<html lang=\"th\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>🦞 ก้ามแดง Dashboard</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}\nbody{background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:#e6e6e6;min-height:100vh;padding:20px}\n.container{max-width:1400px;margin:0 auto}\n\nheader{text-align:center;margin-bottom:28px;padding:22px;background:rgba(255,255,255,0.05);border-radius:15px;border:1px solid rgba(255,255,255,0.1)}\nh1{color:#ff6b6b;font-size:2.4rem;margin-bottom:6px}\n.subtitle{color:#4ecdc4;font-size:1.1rem;opacity:.9}\n.last-update{color:#ffd166;font-size:.85rem;margin-top:8px}\n\n.tabs{display:flex;gap:10px;margin-bottom:28px;flex-wrap:wrap}\n.tab{padding:11px 22px;background:rgba(255,255,255,0.08);border:none;border-radius:8px;color:#e6e6e6;cursor:pointer;font-size:.95rem;transition:all .3s}\n.tab:hover{background:rgba(255,255,255,0.15)}\n.tab.active{background:#ff6b6b;color:#fff;font-weight:700}\n\n.tab-content{display:none}\n.tab-content.active{display:block;animation:fadeIn .4s ease}\n@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:24px}\n.grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:24px}\n\n.card{background:rgba(255,255,255,0.05);border-radius:12px;padding:20px;border:1px solid rgba(255,255,255,0.1);transition:transform .3s,border-color .3s}\n.card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,0.2)}\n.card h3{color:#4ecdc4;margin-bottom:14px;font-size:1.1rem;display:flex;align-items:center;gap:8px}\n\n.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\n.stat-item{text-align:center;padding:14px;background:rgba(255,255,255,0.03);border-radius:8px}\n.stat-value{font-size:1.8rem;font-weight:700;margin:8px 0}\n.stat-label{font-size:.8rem;opacity:.75}\n\n.profit{color:#06d6a0}.loss{color:#ef476f}.neutral{color:#ffd166}\n\n.chart-box{height:280px;margin-top:12px;position:relative}\n\ntable{width:100%;border-collapse:collapse;margin-top:12px;font-size:.9rem}\nth,td{padding:10px 14px;text-align:left;border-bottom:1px solid rgba(255,255,255,0.08)}\nth{background:rgba(255,255,255,0.07);color:#4ecdc4;font-weight:600}\ntr:hover{background:rgba(255,255,255,0.03)}\n\n.badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600;margin:3px}\n.badge.scalp{background:rgba(239,71,111,.2);color:#ef476f;border:1px solid #ef476f}\n.badge.trend{background:rgba(6,214,160,.2);color:#06d6a0;border:1px solid #06d6a0}\n.badge.breakout{background:rgba(255,209,102,.2);color:#ffd166;border:1px solid #ffd166}\n\n/* News */\n.news-item{padding:14px 0;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;gap:14px;align-items:flex-start}\n.news-item:last-child{border-bottom:none}\n.news-dot{width:8px;height:8px;min-width:8px;background:#ff6b6b;border-radius:50%;margin-top:6px}\n.news-title a{color:#e6e6e6;text-decoration:none;font-weight:500;font-size:.95rem;line-height:1.4}\n.news-title a:hover{color:#4ecdc4}\n.news-date{font-size:.75rem;color:rgba(255,255,255,.45);margin-top:4px}\n.news-desc{font-size:.82rem;color:rgba(255,255,255,.6);margin-top:4px;line-height:1.5}\n\n/* Income/Expense */\n.form-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}\n.form-row input,.form-row select{flex:1;min-width:120px;padding:9px 12px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:7px;color:#e6e6e6;font-size:.9rem}\n.form-row input::placeholder{color:rgba(255,255,255,.4)}\n.form-row select option{background:#1a1a2e}\n.btn{padding:9px 18px;border:none;border-radius:7px;cursor:pointer;font-size:.9rem;font-weight:600;transition:all .3s}\n.btn-income{background:#06d6a0;color:#1a1a2e}\n.btn-income:hover{background:#05b589}\n.btn-expense{background:#ef476f;color:#fff}\n.btn-expense:hover{background:#d63d62}\n.btn-clear{background:rgba(255,255,255,.1);color:#e6e6e6}\n.btn-clear:hover{background:rgba(255,255,255,.18)}\n\n.balance-bar{display:flex;gap:16px;margin-bottom:20px;flex-wrap:wrap}\n.balance-card{flex:1;min-width:140px;padding:16px;border-radius:10px;text-align:center}\n.balance-card.income-card{background:rgba(6,214,160,.12);border:1px solid rgba(6,214,160,.3)}\n.balance-card.expense-card{background:rgba(239,71,111,.12);border:1px solid rgba(239,71,111,.3)}\n.balance-card.net-card{background:rgba(255,209,102,.12);border:1px solid rgba(255,209,102,.3)}\n.balance-card .label{font-size:.8rem;opacity:.7;margin-bottom:6px}\n.balance-card .amount{font-size:1.6rem;font-weight:700}\n\n/* Stocks */\n.stock-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:20px}\n.stock-card{padding:16px;background:rgba(255,255,255,0.05);border-radius:10px;border:1px solid rgba(255,255,255,.1);transition:all .3s}\n.stock-card:hover{border-color:rgba(255,255,255,.25)}\n.stock-ticker{font-size:1.1rem;font-weight:700;color:#4ecdc4}\n.stock-name{font-size:.75rem;color:rgba(255,255,255,.5);margin-top:2px}\n.stock-price{font-size:1.5rem;font-weight:700;margin:8px 0}\n.stock-change{font-size:.85rem;font-weight:600}\n.up{color:#06d6a0}.down{color:#ef476f}\n\n.refresh-btn{background:#4ecdc4;color:#1a1a2e;border:none;padding:10px 22px;border-radius:8px;cursor:pointer;font-size:.95rem;margin-top:20px;font-weight:600;transition:background .3s}\n.refresh-btn:hover{background:#3db4ab}\n\n.loading{text-align:center;padding:40px;font-size:1.1rem;color:#ffd166}\n.error-msg{text-align:center;padding:24px;color:#ef476f;background:rgba(239,71,111,.1);border-radius:10px;margin:16px 0}\n\nfooter{text-align:center;margin-top:40px;padding:20px;color:rgba(255,255,255,.45);font-size:.85rem;border-top:1px solid rgba(255,255,255,.1)}\n\n@media(max-width:600px){h1{font-size:1.8rem}.stat-value{font-size:1.5rem}.grid{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<div class=\"container\">\n\n<header>\n  <h1>🦞 ก้ามแดง Dashboard</h1>\n  <div class=\"subtitle\">ศูนย์รวมข้อมูลการเงิน • เทรด • ข่าวสาร</div>\n  <div class=\"last-update\" id=\"lastUpdate\">—</div>\n</header>\n\n<div class=\"tabs\">\n  <button class=\"tab active\" onclick=\"switchTab('news')\">📰 ข่าวเศรษฐกิจ</button>\n  <button class=\"tab\" onclick=\"switchTab('finance')\">💵 รายรับ-รายจ่าย</button>\n  <button class=\"tab\" onclick=\"switchTab('stocks')\">📈 หุ้น</button>\n  <button class=\"tab\" onclick=\"switchTab('gold')\">🥇 เทรดทอง</button>\n</div>\n\n<!-- ─── TAB 1: NEWS ──────────────────────────────────────────────────────── -->\n<div id=\"news\" class=\"tab-content active\">\n  <div class=\"grid\">\n    <div class=\"card\" style=\"grid-column:1/-1\">\n      <h3>📰 ข่าวเศรษฐกิจโลก <span style=\"font-size:.75rem;color:rgba(255,255,255,.4);margin-left:auto\">BBC Business • อัพเดทอัตโนมัติทุก 5 นาที</span></h3>\n      <div id=\"newsContainer\"><div class=\"loading\">⏳ กำลังโหลดข่าว...</div></div>\n    </div>\n  </div>\n  <div style=\"text-align:center\"><button class=\"refresh-btn\" onclick=\"loadNews()\">🔄 รีเฟรชข่าว</button></div>\n</div>\n\n<!-- ─── TAB 2: FINANCE ──────────────────────────────────────────────────── -->\n<div id=\"finance\" class=\"tab-content\">\n  <div class=\"balance-bar\">\n    <div class=\"balance-card income-card\">\n      <div class=\"label\">รายรับทั้งหมด</div>\n      <div class=\"amount profit\" id=\"totalIncome\">฿0</div>\n    </div>\n    <div class=\"balance-card expense-card\">\n      <div class=\"label\">รายจ่ายทั้งหมด</div>\n      <div class=\"amount loss\" id=\"totalExpense\">฿0</div>\n    </div>\n    <div class=\"balance-card net-card\">\n      <div class=\"label\">ยอดสุทธิ</div>\n      <div class=\"amount neutral\" id=\"netBalance\">฿0</div>\n    </div>\n  </div>\n\n  <div class=\"card\" style=\"margin-bottom:20px\">\n    <h3>➕ เพิ่มรายการ</h3>\n    <div class=\"form-row\">\n      <select id=\"txType\">\n        <option value=\"income\">💚 รายรับ</option>\n        <option value=\"expense\">❤️ รายจ่าย</option>\n      </select>\n      <select id=\"txCategory\">\n        <option>เงินเดือน</option>\n        <option>ลงทุน</option>\n        <option>ฟรีแลนซ์</option>\n        <option>ค่าอาหาร</option>\n        <option>ค่าเดินทาง</option>\n        <option>ค่าสาธารณูปโภค</option>\n        <option>ช็อปปิ้ง</option>\n        <option>ความบันเทิง</option>\n        <option>อื่นๆ</option>\n      </select>\n      <input type=\"number\" id=\"txAmount\" placeholder=\"จำนวนเงิน (฿)\" min=\"0\" step=\"0.01\">\n      <input type=\"text\" id=\"txNote\" placeholder=\"หมายเหตุ (ไม่บังคับ)\">\n      <button class=\"btn btn-income\" onclick=\"addTransaction()\">บันทึก</button>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h3>📋 รายการล่าสุด <button class=\"btn btn-clear\" style=\"margin-left:auto;font-size:.8rem;padding:5px 12px\" onclick=\"clearAll()\">ล้างทั้งหมด</button></h3>\n    <table>\n      <thead><tr><th>วันที่</th><th>ประเภท</th><th>หมวด</th><th>จำนวน</th><th>หมายเหตุ</th><th></th></tr></thead>\n      <tbody id=\"txBody\"></tbody>\n    </table>\n  </div>\n</div>\n\n<!-- ─── TAB 3: STOCKS ───────────────────────────────────────────────────── -->\n<div id=\"stocks\" class=\"tab-content\">\n  <div class=\"stock-grid\" id=\"stockGrid\">\n    <div class=\"loading\">⏳ กำลังโหลดข้อมูลหุ้น...</div>\n  </div>\n  <div class=\"card\">\n    <h3>📊 Watchlist Performance (mock)</h3>\n    <div class=\"chart-box\"><canvas id=\"stockChart\"></canvas></div>\n  </div>\n  <div style=\"text-align:center\"><button class=\"refresh-btn\" onclick=\"loadStocks()\">🔄 รีเฟรชหุ้น</button></div>\n</div>\n\n<!-- ─── TAB 4: GOLD TRADING ─────────────────────────────────────────────── -->\n<div id=\"gold\" class=\"tab-content\">\n  <div id=\"goldContent\"><div class=\"loading\">⏳ กำลังโหลดข้อมูลเทรดทอง...</div></div>\n  <div style=\"text-align:center;margin-top:20px\"><button class=\"refresh-btn\" onclick=\"loadGold()\">🔄 รีเฟรชข้อมูลเทรด</button></div>\n</div>\n\n<footer>\n  <p>🦞 ก้ามแดง Dashboard • GoldHunter EA v3.0 • XAUUSD</p>\n  <p style=\"margin-top:4px\">localhost:3001 • อัพเดทอัตโนมัติ</p>\n</footer>\n</div>\n\n<script>\n// ─── TAB SWITCH ─────────────────────────────────────────────────────────────\nfunction switchTab(name) {\n  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));\n  document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));\n  document.getElementById(name).classList.add('active');\n  document.querySelector(`.tab[onclick=\"switchTab('${name}')\"]`).classList.add('active');\n}\n\n// ─── NEWS ────────────────────────────────────────────────────────────────────\nasync function loadNews() {\n  const el = document.getElementById('newsContainer');\n  el.innerHTML = '<div class=\"loading\">⏳ กำลังโหลดข่าว...</div>';\n  try {\n    const r = await fetch('/api/news');\n    const data = await r.json();\n    if (!data.success || !data.items.length) {\n      el.innerHTML = '<div class=\"error-msg\">❌ โหลดข่าวไม่ได้ในขณะนี้</div>';\n      return;\n    }\n    el.innerHTML = data.items.map(item => `\n      <div class=\"news-item\">\n        <div class=\"news-dot\"></div>\n        <div>\n          <div class=\"news-title\"><a href=\"${item.link}\" target=\"_blank\">${item.title}</a></div>\n          ${item.desc ? `<div class=\"news-desc\">${item.desc}</div>` : ''}\n          <div class=\"news-date\">${item.date ? new Date(item.date).toLocaleString('th-TH') : ''}</div>\n        </div>\n      </div>`).join('');\n    updateTime();\n  } catch(e) {\n    el.innerHTML = `<div class=\"error-msg\">❌ ${e.message}</div>`;\n  }\n}\n\n// ─── FINANCE ─────────────────────────────────────────────────────────────────\nlet transactions = JSON.parse(localStorage.getItem('kamdaeng_tx') || '[]');\n\nfunction saveTx() { localStorage.setItem('kamdaeng_tx', JSON.stringify(transactions)); }\n\nfunction addTransaction() {\n  const type = document.getElementById('txType').value;\n  const cat = document.getElementById('txCategory').value;\n  const amount = parseFloat(document.getElementById('txAmount').value);\n  const note = document.getElementById('txNote').value.trim();\n  if (!amount || amount <= 0) { alert('กรุณาใส่จำนวนเงิน'); return; }\n  transactions.unshift({ id: Date.now(), type, cat, amount, note, date: new Date().toLocaleDateString('th-TH') });\n  saveTx(); renderFinance();\n  document.getElementById('txAmount').value = '';\n  document.getElementById('txNote').value = '';\n}\n\nfunction deleteTransaction(id) {\n  transactions = transactions.filter(t => t.id !== id);\n  saveTx(); renderFinance();\n}\n\nfunction clearAll() {\n  if (confirm('ล้างรายการทั้งหมด?')) { transactions = []; saveTx(); renderFinance(); }\n}\n\nfunction renderFinance() {\n  const income = transactions.filter(t => t.type === 'income').reduce((s,t) => s+t.amount, 0);\n  const expense = transactions.filter(t => t.type === 'expense').reduce((s,t) => s+t.amount, 0);\n  const net = income - expense;\n  document.getElementById('totalIncome').textContent = '฿' + income.toLocaleString('th-TH', {minimumFractionDigits:2});\n  document.getElementById('totalExpense').textContent = '฿' + expense.toLocaleString('th-TH', {minimumFractionDigits:2});\n  const netEl = document.getElementById('netBalance');\n  netEl.textContent = '฿' + net.toLocaleString('th-TH', {minimumFractionDigits:2});\n  netEl.className = 'amount ' + (net >= 0 ? 'profit' : 'loss');\n  const tbody = document.getElementById('txBody');\n  if (!transactions.length) {\n    tbody.innerHTML = '<tr><td colspan=\"6\" style=\"text-align:center;opacity:.5;padding:24px\">ยังไม่มีรายการ</td></tr>';\n    return;\n  }\n  tbody.innerHTML = transactions.slice(0,50).map(t => `\n    <tr>\n      <td>${t.date}</td>\n      <td>${t.type === 'income' ? '<span class=\"profit\">💚 รายรับ</span>' : '<span class=\"loss\">❤️ รายจ่าย</span>'}</td>\n      <td>${t.cat}</td>\n      <td class=\"${t.type === 'income' ? 'profit' : 'loss'}\">${t.type === 'income' ? '+' : '-'}฿${t.amount.toLocaleString('th-TH', {minimumFractionDigits:2})}</td>\n      <td style=\"opacity:.7\">${t.note || '-'}</td>\n      <td><button onclick=\"deleteTransaction(${t.id})\" style=\"background:none;border:none;color:#ef476f;cursor:pointer;font-size:1rem\">🗑</button></td>\n    </tr>`).join('');\n}\n\n// ─── STOCKS ──────────────────────────────────────────────────────────────────\nconst STOCKS = [\n  { ticker:'AAPL', name:'Apple Inc.', price:189.30, change:+1.85, pct:+0.99 },\n  { ticker:'GOOGL', name:'Alphabet Inc.', price:165.50, change:-0.72, pct:-0.43 },\n  { ticker:'TSLA', name:'Tesla Inc.', price:175.40, change:+4.20, pct:+2.45 },\n  { ticker:'NVDA', name:'NVIDIA Corp.', price:875.30, change:+12.50, pct:+1.45 },\n  { ticker:'MSFT', name:'Microsoft Corp.', price:415.80, change:+2.30, pct:+0.56 },\n  { ticker:'AMZN', name:'Amazon.com', price:182.60, change:-1.10, pct:-0.60 },\n  { ticker:'META', name:'Meta Platforms', price:510.20, change:+8.40, pct:+1.67 },\n  { ticker:'BRK.B', name:'Berkshire Hathaway', price:402.10, change:+1.05, pct:+0.26 },\n];\n\nlet stockChart = null;\nfunction loadStocks() {\n  const grid = document.getElementById('stockGrid');\n  grid.innerHTML = STOCKS.map(s => `\n    <div class=\"stock-card\">\n      <div class=\"stock-ticker\">${s.ticker}</div>\n      <div class=\"stock-name\">${s.name}</div>\n      <div class=\"stock-price\">$${s.price.toFixed(2)}</div>\n      <div class=\"stock-change ${s.change >= 0 ? 'up' : 'down'}\">\n        ${s.change >= 0 ? '▲' : '▼'} $${Math.abs(s.change).toFixed(2)} (${s.pct >= 0 ? '+' : ''}${s.pct.toFixed(2)}%)\n      </div>\n    </div>`).join('');\n\n  const ctx = document.getElementById('stockChart').getContext('2d');\n  if (stockChart) stockChart.destroy();\n  stockChart = new Chart(ctx, {\n    type: 'bar',\n    data: {\n      labels: STOCKS.map(s => s.ticker),\n      datasets: [{\n        label: '% Change',\n        data: STOCKS.map(s => s.pct),\n        backgroundColor: STOCKS.map(s => s.pct >= 0 ? 'rgba(6,214,160,.7)' : 'rgba(239,71,111,.7)'),\n        borderColor: STOCKS.map(s => s.pct >= 0 ? '#06d6a0' : '#ef476f'),\n        borderWidth: 1, borderRadius: 5\n      }]\n    },\n    options: {\n      responsive: true, maintainAspectRatio: false,\n      plugins: { legend: { display: false } },\n      scales: {\n        x: { ticks: { color: '#e6e6e6' }, grid: { color: 'rgba(255,255,255,.05)' } },\n        y: { ticks: { color: '#e6e6e6', callback: v => v + '%' }, grid: { color: 'rgba(255,255,255,.08)' } }\n      }\n    }\n  });\n  updateTime();\n}\n\n// ─── GOLD TRADING ─────────────────────────────────────────────────────────────\nlet equityChart = null;\nasync function loadGold() {\n  const el = document.getElementById('goldContent');\n  el.innerHTML = '<div class=\"loading\">⏳ กำลังโหลดข้อมูลเทรดทอง...</div>';\n  try {\n    const r = await fetch('/api/gold');\n    const res = await r.json();\n    if (!res.success) {\n      el.innerHTML = `<div class=\"error-msg\">❌ ${res.error}</div>`;\n      return;\n    }\n    const d = res.data;\n    const s = d.summary;\n    const hist = d.historical || [];\n    const plColor = s.profit_loss >= 0 ? 'profit' : 'loss';\n    const plSign = s.profit_loss >= 0 ? '+' : '';\n    const tagColor = s.tag === 'ACTIVE' || s.tag === 'START' ? '#06d6a0' : '#ffd166';\n    const lastUpdate = s.last_update ? new Date(s.last_update).toLocaleString('th-TH') : '-';\n\n    el.innerHTML = `\n      <div class=\"grid\">\n        <div class=\"card\">\n          <h3>💰 สรุปผลวันนี้</h3>\n          <div class=\"stats-grid\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">กำไร/ขาดทุน</div>\n              <div class=\"stat-value ${plColor}\">${plSign}$${s.profit_loss.toFixed(2)}</div>\n              <div class=\"stat-label\">P&L Today</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">จำนวนเทรด</div>\n              <div class=\"stat-value neutral\">${s.total_trades}</div>\n              <div class=\"stat-label\">วันนี้</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">Win Rate</div>\n              <div class=\"stat-value ${s.win_rate >= 60 ? 'profit' : s.win_rate > 0 ? 'neutral' : 'loss'}\">${s.win_rate.toFixed(1)}%</div>\n              <div class=\"stat-label\">${s.wins}W / ${s.losses}L</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">Balance</div>\n              <div class=\"stat-value neutral\">$${s.balance.toLocaleString('en-US',{minimumFractionDigits:2})}</div>\n              <div class=\"stat-label\">Equity: $${s.equity.toLocaleString('en-US',{minimumFractionDigits:2})}</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <h3>🎯 สถานะ EA</h3>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:8px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center\">\n              <span style=\"opacity:.7\">สถานะ</span>\n              <span style=\"color:${tagColor};font-weight:700\">${s.tag}</span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;align-items:center\">\n              <span style=\"opacity:.7\">กลยุทธ์</span>\n              <span class=\"badge ${s.strategy.toLowerCase()}\">${s.strategy}</span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;align-items:center\">\n              <span style=\"opacity:.7\">อัพเดทล่าสุด</span>\n              <span style=\"font-size:.85rem;color:#ffd166\">${lastUpdate}</span>\n            </div>\n            <div style=\"margin-top:8px;padding:12px;background:rgba(255,255,255,.04);border-radius:8px;font-size:.85rem;opacity:.8;line-height:1.5\">${s.message}</div>\n          </div>\n        </div>\n\n        <div class=\"card\" style=\"grid-column:1/-1\">\n          <h3>📈 Equity Curve</h3>\n          <div class=\"chart-box\"><canvas id=\"equityChart\"></canvas></div>\n        </div>\n\n        ${hist.length > 0 ? `\n        <div class=\"card\" style=\"grid-column:1/-1\">\n          <h3>📋 ประวัติย้อนหลัง</h3>\n          <table>\n            <thead><tr><th>วันที่</th><th>เทรด</th><th>ชนะ</th><th>แพ้</th><th>P&L</th><th>Balance</th></tr></thead>\n            <tbody>${hist.slice().reverse().map(h => `\n              <tr>\n                <td>${h.date}</td>\n                <td>${h.trades}</td>\n                <td class=\"profit\">${h.wins}</td>\n                <td class=\"loss\">${h.losses}</td>\n                <td class=\"${h.pl >= 0 ? 'profit' : 'loss'}\">${h.pl >= 0 ? '+' : ''}$${h.pl.toFixed(2)}</td>\n                <td>$${h.balance.toLocaleString('en-US',{minimumFractionDigits:2})}</td>\n              </tr>`).join('')}\n            </tbody>\n          </table>\n        </div>` : ''}\n      </div>`;\n\n    // Draw equity chart\n    if (hist.length > 0) {\n      const ctx = document.getElementById('equityChart').getContext('2d');\n      if (equityChart) equityChart.destroy();\n      equityChart = new Chart(ctx, {\n        type: 'line',\n        data: {\n          labels: hist.map(h => h.date),\n          datasets: [{\n            label: 'Balance ($)',\n            data: hist.map(h => h.balance),\n            borderColor: '#ffd166',\n            backgroundColor: 'rgba(255,209,102,.1)',\n            borderWidth: 2, tension: 0.3, fill: true,\n            pointBackgroundColor: '#ffd166', pointRadius: 4\n          }]\n        },\n        options: {\n          responsive: true, maintainAspectRatio: false,\n          plugins: { legend: { labels: { color: '#e6e6e6' } } },\n          scales: {\n            x: { ticks: { color: '#e6e6e6' }, grid: { color: 'rgba(255,255,255,.05)' } },\n            y: { ticks: { color: '#e6e6e6', callback: v => '$'+v.toLocaleString() }, grid: { color: 'rgba(255,255,255,.08)' } }\n          }\n        }\n      });\n    }\n    updateTime();\n  } catch(e) {\n    el.innerHTML = `<div class=\"error-msg\">❌ ${e.message}</div>`;\n  }\n}\n\n// ─── UTILS ───────────────────────────────────────────────────────────────────\nfunction updateTime() {\n  document.getElementById('lastUpdate').textContent = 'อัพเดทล่าสุด: ' + new Date().toLocaleString('th-TH');\n}\n\n// ─── INIT ─────────────────────────────────────────────────────────────────────\nloadNews();\nrenderFinance();\nloadStocks();\nloadGold();\n\n// auto-refresh news every 5 min\nsetInterval(loadNews, 5 * 60 * 1000);\n// auto-refresh gold every 30 sec\nsetInterval(loadGold, 30 * 1000);\n</script>\n</body>\n</html>\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":8708,"cacheRead":68000,"cacheWrite":915,"totalTokens":77624,"cost":{"input":0.000003,"output":0.13062,"cacheRead":0.020399999999999998,"cacheWrite":0.0034312500000000003,"total":0.15445425000000002}},"stopReason":"toolUse","timestamp":1773993722476}}
