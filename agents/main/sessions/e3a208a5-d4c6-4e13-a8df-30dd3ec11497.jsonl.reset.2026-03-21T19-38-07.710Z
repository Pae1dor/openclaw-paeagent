.2);\n        }\n        \n        .card h3 {\n            color: #4ecdc4;\n            margin-bottom: 15px;\n            font-size: 1.2rem;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        .card h3 i {\n            font-size: 1.5rem;\n        }\n        \n        .stats-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 15px;\n        }\n        \n        .stat-item {\n            text-align: center;\n            padding: 15px;\n            background: rgba(255, 255, 255, 0.03);\n            border-radius: 8px;\n        }\n        \n        .stat-value {\n            font-size: 2rem;\n            font-weight: bold;\n            margin: 10px 0;\n        }\n        \n\n[369 more lines in file. Use offset=151 to continue.]"}],"isError":false,"timestamp":1773993691578}}
