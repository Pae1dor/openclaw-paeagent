\n+340       <div class=\"balance-card income-card\">\n+341         <div class=\"label\">มูลค่ารวม</div>\n+342         <div class=\"amount profit\">$${totalValue.toLocaleString('en-US',{minimumFractionDigits:2})}</div>\n+343         <div style=\"font-size:.75rem;opacity:.6;margin-top:4px\">≈ ฿${(totalValue*32.57).toLocaleString('th-TH',{maximumFractionDigits:0})}</div>\n+344       </div>\n+345       <div class=\"balance-card net-card\">\n+346         <div class=\"label\">กำไร/ขาดทุนรวม</div>\n+347         <div class=\"amount ${totalProfit>=0?'profit':'loss'}\">${totalProfit>=0?'+':''}$${totalProfit.toFixed(2)}</div>\n+348         <div style=\"font-size:.75rem;opacity:.6;margin-top:4px\">${totalPct>=0?'+':''}${totalPct.toFixed(2)}%</div>\n+349       </div>\n+350       <div class=\"balance-card\" style=\"background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.15)\">\n+351         <div class=\"label\">จำนวนสินทรัพย์</div>\n+352         <div class=\"amount neutral\">${portfolio.length}</div>\n+353         <div style=\"font-size:.75rem;opacity:.6;margin-top:4px\">รายการ</div>\n+354       </div>\n+355     </div>`;\n+356 \n 305   const grid = document.getElementById('stockGrid');\n-306   grid.innerHTML = STOCKS.map(s => `\n+358   grid.innerHTML = portfolio.map((s,i) => `\n 307     <div class=\"stock-card\">\n-308       <div class=\"stock-ticker\">${s.ticker}</div>\n-309       <div class=\"stock-name\">${s.name}</div>\n-310       <div class=\"stock-price\">$${s.price.toFixed(2)}</div>\n-311       <div class=\"stock-change ${s.change >= 0 ? 'up' : 'down'}\">\n-312         ${s.change >= 0 ? '▲' : '▼'} $${Math.abs(s.change).toFixed(2)} (${s.pct >= 0 ? '+' : ''}${s.pct.toFixed(2)}%)\n+360       <div style=\"display:flex;justify-content:space-between;align-items:flex-start\">\n+361         <div>\n+362           <div class=\"stock-ticker\">${s.ticker}</div>\n+363           <div class=\"stock-name\">${s.name}</div>\n+364         </div>\n+365         <button onclick=\"removeStock(${i})\" style=\"background:none;border:none;color:rgba(239,71,111,.5);cursor:pointer;font-size:1.1rem;line-height:1\" title=\"ลบ\">✕</button>\n 313       </div>\n+367       <div class=\"stock-price\">$${s.value.toFixed(2)}</div>\n+368       <div class=\"stock-change ${s.pct >= 0 ? 'up' : 'down'}\">\n+369         ${s.pct >= 0 ? '▲' : '▼'} ${s.pct >= 0?'+':''}${s.pct.toFixed(2)}%\n+370         ${s.profit ? `<span style=\"opacity:.7;font-size:.8rem\">(${s.profit>=0?'+':''}$${s.profit.toFixed(2)})</span>` : ''}\n+371       </div>\n+372       ${s.note ? `<div style=\"font-size:.72rem;opacity:.5;margin-top:6px;line-height:1.4\">${s.note}</div>` : ''}\n 314     </div>`).join('');\n 315 \n+375   // Bar chart กำไร %\n 316   const ctx = document.getElementById('stockChart').getContext('2d');\n 317   if (stockChart) stockChart.destroy();\n 318   stockChart = new Chart(ctx, {\n 319     type: 'bar',\n 320     data: {\n-321       labels: STOCKS.map(s => s.ticker),\n+381       labels: portfolio.map(s => s.ticker),\n 322       datasets: [{\n-323         label: '% Change',\n-324         data: STOCKS.map(s => s.pct),\n-325         backgroundColor: STOCKS.map(s => s.pct >= 0 ? 'rgba(6,214,160,.7)' : 'rgba(239,71,111,.7)'),\n-326         borderColor: STOCKS.map(s => s.pct >= 0 ? '#06d6a0' : '#ef476f'),\n+383         label: '% กำไร/ขาดทุน',\n+384         data: portfolio.map(s => s.pct),\n+385         backgroundColor: portfolio.map(s => s.pct >= 0 ? 'rgba(6,214,160,.7)' : 'rgba(239,71,111,.7)'),\n+386         borderColor: portfolio.map(s => s.pct >= 0 ? '#06d6a0' : '#ef476f'),\n 327         borderWidth: 1, borderRadius: 5\n 328       }]\n 329     },\n 330     options: {\n     ...","firstChangedLine":292},"isError":false,"timestamp":1773994603625}}
