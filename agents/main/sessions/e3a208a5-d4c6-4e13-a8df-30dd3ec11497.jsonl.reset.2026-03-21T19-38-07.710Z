{"type":"message","id":"095eeb6b","parentId":"78bf3020","timestamp":"2026-03-20T07:46:26.439Z","message":{"role":"assistant","content":[{"type":"text","text":"7. **สร้าง script อัพเดทข้อมูล**"},{"type":"toolCall","id":"call_00_WD1UTftj2fgftsPdTE664vMy","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\update_goldhunter_data.py","content":"#!/usr/bin/env python3\n\"\"\"\nScript to update GoldHunter trading data from CSV log file\n\"\"\"\n\nimport pandas as pd\nimport json\nimport os\nfrom datetime import datetime, timedelta\nimport sys\n\ndef read_goldhunter_log(filepath):\n    \"\"\"Read GoldHunter CSV log file\"\"\"\n    try:\n        # Try UTF-16 LE first (with BOM)\n        df = pd.read_csv(filepath, encoding='utf-16-le')\n        print(f\"Successfully read {len(df)} rows from {filepath}\")\n        return df\n    except Exception as e:\n        print(f\"Error reading {filepath}: {e}\")\n        # Create sample data if file doesn't exist\n        return pd.DataFrame({\n            'DateTime': [datetime.now().strftime('%Y.%m.%d %H:%M:%S')],\n            'Tag': ['NO_DATA'],\n            'Message': ['Waiting for GoldHunter EA data'],\n            'Balance': [100000.00],\n            'Equity': [100000.00],\n            'Profit': [0.00],\n            'DailyTrades': [0],\n            'DailyWins': [0],\n            'DailyLosses': [0],\n            'DailyPL': [0.00]\n        })\n\ndef extract_trading_summary(df, target_date=None):\n    \"\"\"Extract trading summary for a specific date\"\"\"\n    if target_date is None:\n        target_date = datetime.now().strftime('%Y.%m.%d')\n    \n    # Filter for today's data\n    today_data = df[df['DateTime'].str.startswith(target_date)]\n    \n    if len(today_data) == 0:\n        return {\n            'date': target_date.replace('.', '-'),\n            'total_trades': 0,\n            'wins': 0,\n            'losses': 0,\n            'profit_loss': 0.0,\n            'balance': 100000.00,\n            'equity': 100000.00,\n            'win_rate': 0.0,\n            'strategy': 'UNKNOWN',\n            'last_update': datetime.now().isoformat(),\n            'tag': 'NO_DATA',\n            'message': 'No trading data available for today'\n        }\n    \n    # Get the latest row\n    latest = today_data.iloc[-1]\n    \n    # Determine strategy from message\n    message = str(latest.get('Message', ''))\n    strategy = 'UNKNOWN'\n    if 'SCALP' in message.upper():\n        strategy = 'SCALP'\n    elif 'TREND' in message.upper():\n        strategy = 'TREND'\n    elif 'BREAKOUT' in message.upper():\n        strategy = 'BREAKOUT'\n    \n    # Calculate win rate\n    total_trades = int(latest.get('DailyTrades', 0))\n    wins = int(latest.get('DailyWins', 0))\n    losses = int(latest.get('DailyLosses', 0))\n    win_rate = (wins / total_trades * 100) if total_trades > 0 else 0.0\n    \n    return {\n        'date': target_date.replace('.', '-'),\n        'total_trades': total_trades,\n        'wins': wins,\n        'losses': losses,\n        'profit_loss': float(latest.get('DailyPL', 0.0)),\n        'balance': float(latest.get('Balance', 100000.00)),\n        'equity': float(latest.get('Equity', 100000.00)),\n        'win_rate': round(win_rate, 1),\n        'strategy': strategy,\n        'last_update': datetime.now().isoformat(),\n        'tag': latest.get('Tag', 'UNKNOWN'),\n        'message': message\n    }\n\ndef get_historical_data(df, days=30):\n    \"\"\"Get historical data for the last N days\"\"\"\n    historical = []\n    \n    # Get unique dates\n    if 'DateTime' in df.columns:\n        df['Date'] = df['DateTime'].str.split(' ').str[0]\n        unique_dates = df['Date'].unique()\n        \n        for date_str in unique_dates[-days:]:\n            day_data = df[df['Date'] == date_str]\n            if len(day_data) > 0:\n                latest = day_data.iloc[-1]\n                historical.append({\n                    'date': date_str.replace('.', '-'),\n                    'trades': int(latest.get('DailyTrades', 0)),\n                    'wins': int(latest.get('DailyWins', 0)),\n                    'losses': int(latest.get('DailyLosses', 0)),\n                    'pl': float(latest.get('DailyPL', 0.0)),\n                    'balance': float(latest.get('Balance', 100000.00)),\n                    'strategy': 'MIXED'\n                })\n    \n    return historical\n\ndef main():\n    \"\"\"Main function\"\"\"\n    log_file = 'C:\\\\Users\\\\hp\\\\AppData\\\\Roaming\\\\MetaQuotes\\\\Terminal\\\\Common\\\\Files\\\\GoldHunter_Log.csv'\n    output_file = 'C:\\\\Users\\\\hp\\\\.openclaw\\\\workspace\\\\goldhunter_data.json'\n    \n    print(f\"Reading log file: {log_file}\")\n    print(f\"Output file: {output_file}\")\n    \n    # Read data\n    df = read_goldhunter_log(log_file)\n    \n    # Extract summary\n    summary = extract_trading_summary(df)\n    \n    # Get historical data\n    historical = get_historical_data(df, days=7)\n    \n    # Prepare output\n    output_data = {\n        'summary': summary,\n        'historical': historical,\n        'last_updated': datetime.now().isoformat()\n    }\n    \n    # Write to file\n    with open(output_file, 'w', encoding='utf-8') as f:\n        json.dump(output_data, f, indent=2, ensure_ascii=False)\n    \n    print(f\"Data updated successfully!\")\n    print(f\"Summary: {summary['total_trades']} trades, P&L: ${summary['profit_loss']:.2f}\")\n    print(f\"Historical data: {len(historical)} days\")\n    \n    return 0\n\nif __name__ == '__main__':\n    sys.exit(main())"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":50,"output":1419,"cacheRead":33920,"cacheWrite":0,"totalTokens":35389,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773992742395}}
