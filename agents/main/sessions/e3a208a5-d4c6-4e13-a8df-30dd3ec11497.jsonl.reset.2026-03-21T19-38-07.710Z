{"type":"message","id":"bc79866e","parentId":"511355e9","timestamp":"2026-03-20T06:19:47.300Z","message":{"role":"toolResult","toolCallId":"call_00_08nHYlqkcAD8yoBoxznngLKS","toolName":"exec","content":[{"type":"text","text":"2026.03.20 08:10:36,START,GoldHunter EA v3.0 on XAUUSD | Lot:0.01 SL/TP:50 RR:1:1,100000.00,100000.00,0.00,0,0,0,0.00\r\n2026.03.20 08:11:55,STOP,STOP | Trades:0 W:0 L:0 P&L:$0.00,100000.00,100000.00,0.00,0,0,0,0.00\r\n2026.03.20 08:17:23,START,GoldHunter EA v3.0 on XAUUSD | Lot:0.02 SL/TP:50 RR:1:1,100000.00,100000.00,0.00,0,0,0,0.00"}],"details":{"status":"completed","exitCode":0,"durationMs":833,"aggregated":"2026.03.20 08:10:36,START,GoldHunter EA v3.0 on XAUUSD | Lot:0.01 SL/TP:50 RR:1:1,100000.00,100000.00,0.00,0,0,0,0.00\r\n2026.03.20 08:11:55,STOP,STOP | Trades:0 W:0 L:0 P&L:$0.00,100000.00,100000.00,0.00,0,0,0,0.00\r\n2026.03.20 08:17:23,START,GoldHunter EA v3.0 on XAUUSD | Lot:0.02 SL/TP:50 RR:1:1,100000.00,100000.00,0.00,0,0,0,0.00","cwd":"C:\\Users\\hp\\.openclaw\\workspace"},"isError":false,"timestamp":1773987587298}}
{"type":"message","id":"b74ad551","parentId":"bc79866e","timestamp":"2026-03-20T06:20:36.261Z","message":{"role":"assistant","content":[{"type":"text","text":"ดี! ตอนนี้อ่านได้แล้ว ดูเหมือนยังไม่มีข้อมูลเทรดจริงๆ (ยังเป็น 0 trades) แต่โครงสร้างไฟล์ชัดเจน\n\n## 2. สร้าง script สำหรับอ่านและสรุปผล\n\nมาสร้าง Python script สำหรับอ่านไฟล์ CSV และสรุปผลเทรด"},{"type":"toolCall","id":"call_00_j3zUM2cFTeH8sF2GoBtHnm0A","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\goldhunter_summary.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nGoldHunter EA Trading Summary Script\nอ่านไฟล์ log จาก MT5 และสรุปผลเทรด\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport os\nimport sys\nimport json\nfrom pathlib import Path\n\ndef read_goldhunter_log(file_path):\n    \"\"\"อ่านไฟล์ GoldHunter_Log.csv\"\"\"\n    try:\n        # อ่านไฟล์ CSV ที่เป็น UTF-16 LE\n        df = pd.read_csv(file_path, encoding='utf-16-le', header=None)\n        \n        # ตั้งชื่อคอลัมน์ตามที่ระบุ\n        columns = [\n            'DateTime', 'Tag', 'Message', \n            'Balance', 'Equity', 'Profit', \n            'DailyTrades', 'DailyWins', 'DailyLosses', 'DailyPL'\n        ]\n        \n        if len(df.columns) == len(columns):\n            df.columns = columns\n        else:\n            # ถ้าจำนวนคอลัมน์ไม่ตรง ให้ใช้ชื่อ default\n            df.columns = [f'col{i}' for i in range(len(df.columns))]\n            print(f\"Warning: Expected {len(columns)} columns, got {len(df.columns)}\")\n        \n        # แปลง DateTime เป็น datetime object\n        df['DateTime'] = pd.to_datetime(df['DateTime'], format='%Y.%m.%d %H:%M:%S')\n        \n        # แปลงคอลัมน์ตัวเลข\n        numeric_cols = ['Balance', 'Equity', 'Profit', 'DailyTrades', 'DailyWins', 'DailyLosses', 'DailyPL']\n        for col in numeric_cols:\n            if col in df.columns:\n                df[col] = pd.to_numeric(df[col], errors='coerce')\n        \n        return df\n    except Exception as e:\n        print(f\"Error reading file: {e}\")\n        return None\n\ndef extract_trading_summary(df, target_date=None):\n    \"\"\"สรุปผลเทรดสำหรับวันที่กำหนด\"\"\"\n    if df is None or df.empty:\n        return None\n    \n    # ถ้าไม่ระบุวันที่ ให้ใช้วันนี้\n    if target_date is None:\n        target_date = datetime.now().date()\n    else:\n        target_date = pd.to_datetime(target_date).date()\n    \n    # กรองข้อมูลของวันที่ต้องการ\n    df_date = df[df['DateTime'].dt.date == target_date]\n    \n    if df_date.empty:\n        print(f\"No data for date: {target_date}\")\n        return None\n    \n    # หา record ล่าสุดของวัน (ควรเป็น STOP หรือ record สุดท้าย)\n    last_record = df_date.iloc[-1]\n    \n    # สรุปผล\n    summary = {\n        'date': target_date.strftime('%Y-%m-%d'),\n        'total_trades': int(last_record.get('DailyTrades', 0)) if pd.notna(last_record.get('DailyTrades')) else 0,\n        'wins': int(last_record.get('DailyWins', 0)) if pd.notna(last_record.get('DailyWins')) else 0,\n        'losses': int(last_record.get('DailyLosses', 0)) if pd.notna(last_record.get('DailyLosses')) else 0,\n        'profit_loss': float(last_record.get('DailyPL', 0.0)) if pd.notna(last_record.get('DailyPL')) else 0.0,\n        'balance': float(last_record.get('Balance', 0.0)) if pd.notna(last_record.get('Balance')) else 0.0,\n        'equity': float(last_record.get('Equity', 0.0)) if pd.notna(last_record.get('Equity')) else 0.0,\n        'last_update': last_record['DateTime'].strftime('%Y-%m-%d %H:%M:%S') if pd.notna(last_record['DateTime']) else '',\n        'tag': last_record.get('Tag', ''),\n        'message': last_record.get('Message', '')\n    }\n    \n    # คำนวณ win rate\n    if summary['total_trades'] > 0:\n        summary['win_rate'] = (summary['wins'] / summary['total_trades']) * 100\n    else:\n        summary['win_rate'] = 0.0\n    \n    # ตรวจสอบกลยุทธ์จาก Message\n    message = str(summary['message']).upper()\n    if 'SCALP' in message:\n        summary['strategy'] = 'SCALP'\n    elif 'TREND' in message:\n        summary['strategy'] = 'TREND'\n    elif 'BREAKOUT' in message:\n        summary['strategy'] = 'BREAKOUT'\n    else:\n        summary['strategy'] = 'UNKNOWN'\n    \n    return summary\n\ndef format_telegram_message(summary):\n    \"\"\"จัดรูปแบบข้อความสำหรับส่ง Telegram\"\"\"\n    if not summary:\n        return \"❌ No trading data available for today.\"\n    \n    # สัญลักษณ์กำไร/ขาดทุน\n    pl_symbol = \"📈\" if summary['profit_loss'] >= 0 else \"📉\"\n    \n    message = f\"\"\"\n🦞 *GoldHunter EA Trading Summary*\n📅 Date: {summary['date']}\n⏰ Last Update: {summary['last_update']}\n\n📊 *Performance Today:*\n• Total Trades: {summary['total_trades']}\n• Wins: {summary['wins']} | Losses: {summary['losses']}\n• Win Rate: {summary['win_rate']:.1f}%\n• P&L: {pl_symbol} ${summary['profit_loss']:,.2f}\n\n💰 *Account Status:*\n• Balance: ${summary['balance']:,.2f}\n• Equity: ${summary['equity']:,.2f}\n\n🎯 Strategy: {summary['strategy']}\n📝 Status: {summary['tag']} - {summary['message'][:50]}...\n\n_Generated by ก้ามแดง Dashboard_\n\"\"\"\n    return message\n\ndef get_historical_data(df, days=30):\n    \"\"\"ดึงข้อมูลย้อนหลังสำหรับกราฟ\"\"\"\n    if df is None or df.empty:\n        return []\n    \n    # กรองข้อมูล 30 วันย้อนหลัง\n    cutoff_date = datetime.now() - timedelta(days=days)\n    historical = df[df['DateTime'] >= cutoff_date].copy()\n    \n    # จัดกลุ่มตามวัน\n    historical['Date'] = historical['DateTime'].dt.date\n    \n    # หาค่า DailyPL สุดท้ายของแต่ละวัน\n    daily_data = []\n    for date, group in historical.groupby('Date'):\n        last_record = group.iloc[-1]\n        daily_data.append({\n            'date': date.strftime('%Y-%m-%d'),\n            'pl': float(last_record.get('DailyPL', 0.0)) if pd.notna(last_record.get('DailyPL')) else 0.0,\n            'trades': int(last_record.get('DailyTrades', 0)) if pd.notna(last_record.get('DailyTrades')) else 0,\n            'balance': float(last_record.get('Balance', 0.0)) if pd.notna(last_record.get('Balance')) else 0.0\n        })\n    \n    return daily_data\n\ndef main():\n    \"\"\"ฟังก์ชันหลัก\"\"\"\n    # Path ไฟล์ log\n    log_path = r\"C:\\Users\\hp\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files\\GoldHunter_Log.csv\"\n    \n    if not os.path.exists(log_path):\n        print(f\"Error: File not found: {log_path}\")\n        return\n    \n    # อ่านข้อมูล\n    print(f\"Reading log file: {log_path}\")\n    df = read_goldhunter_log(log_path)\n    \n    if df is None:\n        print(\"Failed to read log file\")\n        return\n    \n    print(f\"Total records: {len(df)}\")\n    print(f\"Date range: {df['DateTime'].min()} to {df['DateTime'].max()}\")\n    \n    # สรุปผลวันนี้\n    today_summary = extract_trading_summary(df)\n    \n    if today_summary:\n        print(\"\\n=== Today's Trading Summary ===\")\n        print(f\"Date: {today_summary['date']}\")\n        print(f\"Total Trades: {today_summary['total_trades']}\")\n        print(f\"Wins: {today_summary['wins']} | Losses: {today_summary['losses']}\")\n        print(f\"Win Rate: {today_summary['win_rate']:.1f}%\")\n        print(f\"P&L: ${today_summary['profit_loss']:,.2f}\")\n        print(f\"Balance: ${today_summary['balance']:,.2f}\")\n        print(f\"Equity: ${today_summary['equity']:,.2f}\")\n        print(f\"Strategy: {today_summary['strategy']}\")\n        \n        # สร้างข้อความ Telegram\n        telegram_msg = format_telegram_message(today_summary)\n        print(\"\\n=== Telegram Message ===\")\n        print(telegram_msg)\n        \n        # บันทึกเป็น JSON สำหรับ dashboard\n        output_data = {\n            'summary': today_summary,\n            'historical': get_historical_data(df, days=30),\n            'raw_stats': {\n                'total_records': len(df),\n                'date_range': {\n                    'start': df['DateTime'].min().strftime('%Y-%m-%d %H:%M:%S'),\n                    'end': df['DateTime'].max().strftime('%Y-%m-%d %H:%M:%S')\n                }\n            }\n        }\n        \n        # บันทึกไฟล์ JSON\n        output_path = Path.home() / '.openclaw' / 'workspace' / 'goldhunter_data.json'\n        with open(output_path, 'w', encoding='utf-8') as f:\n            json.dump(output_data, f, indent=2, ensure_ascii=False)\n        \n        print(f\"\\nData saved to: {output_path}\")\n        \n        # ส่งข้อความผ่าน sessions_send (ถ้ามี Telegram session)\n        try:\n            # ตรวจสอบว่ามี Telegram session หรือไม่\n            import subprocess\n            result = subprocess.run(['openclaw', 'sessions', 'list'], \n                                  capture_output=True, text=True)\n            if 'telegram' in result.stdout.lower():\n                # ส่งผ่าน openclaw CLI\n                subprocess.run([\n                    'openclaw', 'sessions', 'send',\n                    '--label', 'telegram',\n                    telegram_msg\n                ])\n                print(\"Message sent to Telegram via OpenClaw\")\n        except:\n            print(\"Note: To send to Telegram automatically, set up Telegram session in OpenClaw\")\n    else:\n        print(\"No trading data available for today\")\n\nif __name__ == \"__main__\":\n    main()"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":266,"output":2502,"cacheRead":15424,"cacheWrite":0,"totalTokens":18192,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773987587301}}
