{"type":"message","id":"ac6766d6","parentId":"8baa1696","timestamp":"2026-03-20T06:21:25.886Z","message":{"role":"assistant","content":[{"type":"text","text":"ดี! script ทำงานได้แล้ว ตอนนี้มีข้อมูลบันทึกไว้ใน `goldhunter_data.json`\n\n## 4. สร้าง cron job สำหรับ 22:00 เวลาไทย\n\nต้องตั้ง cron job ที่รันทุกวัน 22:00 (GMT+7) ซึ่งคือ 15:00 UTC\n\nมาสร้าง script สำหรับ cron job:"},{"type":"toolCall","id":"call_00_h7SbOGCJribFs2FwuLRHLMUq","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\goldhunter_cron.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nGoldHunter Cron Job - รันทุกวัน 22:00 เวลาไทย\n\"\"\"\n\nimport sys\nimport os\nsys.path.append(os.path.dirname(os.path.abspath(__file__)))\n\nfrom goldhunter_summary import (\n    read_goldhunter_log, \n    extract_trading_summary, \n    format_telegram_message\n)\nimport subprocess\nimport json\nfrom datetime import datetime\n\ndef send_to_telegram_via_openclaw(message):\n    \"\"\"ส่งข้อความผ่าน OpenClaw ไปยัง Telegram\"\"\"\n    try:\n        # ใช้ openclaw CLI เพื่อส่งข้อความ\n        result = subprocess.run(\n            ['openclaw', 'sessions', 'send', '--label', 'telegram', message],\n            capture_output=True,\n            text=True,\n            timeout=10\n        )\n        \n        if result.returncode == 0:\n            print(\"✅ Message sent to Telegram successfully\")\n            return True\n        else:\n            print(f\"❌ Failed to send to Telegram: {result.stderr}\")\n            return False\n            \n    except FileNotFoundError:\n        print(\"❌ OpenClaw CLI not found\")\n        return False\n    except subprocess.TimeoutExpired:\n        print(\"❌ Timeout sending to Telegram\")\n        return False\n    except Exception as e:\n        print(f\"❌ Error sending to Telegram: {e}\")\n        return False\n\ndef main():\n    print(f\"=== GoldHunter Cron Job - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ===\")\n    \n    # Path ไฟล์ log\n    log_path = r\"C:\\Users\\hp\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files\\GoldHunter_Log.csv\"\n    \n    if not os.path.exists(log_path):\n        print(f\"❌ File not found: {log_path}\")\n        return\n    \n    # อ่านข้อมูล\n    df = read_goldhunter_log(log_path)\n    if df is None or df.empty:\n        print(\"❌ No data in log file\")\n        return\n    \n    # สรุปผลวันนี้\n    today_summary = extract_trading_summary(df)\n    \n    if not today_summary:\n        print(\"❌ No trading summary for today\")\n        return\n    \n    print(f\"📊 Today's Summary: {today_summary['total_trades']} trades, P&L: ${today_summary['profit_loss']:,.2f}\")\n    \n    # สร้างข้อความ Telegram\n    telegram_msg = format_telegram_message(today_summary)\n    \n    # ส่งไปยัง Telegram\n    print(\"\\n📤 Sending to Telegram...\")\n    success = send_to_telegram_via_openclaw(telegram_msg)\n    \n    if success:\n        print(\"✅ Cron job completed successfully\")\n    else:\n        print(\"⚠️ Cron job completed but Telegram send failed\")\n        \n        # บันทึกข้อความไว้ในไฟล์ถ้าส่งไม่สำเร็จ\n        backup_file = os.path.join(os.path.dirname(__file__), \"telegram_backup.txt\")\n        with open(backup_file, 'a', encoding='utf-8') as f:\n            f.write(f\"\\n=== {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ===\\n\")\n            f.write(telegram_msg + \"\\n\")\n        print(f\"📝 Message saved to backup file: {backup_file}\")\n\nif __name__ == \"__main__\":\n    main()"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":453,"output":915,"cacheRead":19328,"cacheWrite":0,"totalTokens":20696,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773987667226}}
