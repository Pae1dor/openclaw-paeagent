{"type":"message","id":"34c25900","parentId":"8ddfcadf","timestamp":"2026-03-20T06:51:12.010Z","message":{"role":"assistant","content":[{"type":"text","text":"ตอนนี้ต้องสร้าง API route สำหรับดึงข้อมูลจาก GoldHunter"},{"type":"toolCall","id":"call_00_NBMF9haxIPUkJtepj1pDAi8c","name":"write","arguments":{"path":"C:\\Users\\hp\\Desktop\\clawd\\app\\api\\gold-trading\\route.ts","content":"import { NextRequest, NextResponse } from 'next/server';\nimport fs from 'fs';\nimport path from 'path';\n\n// Path to GoldHunter data\nconst GOLDHUNTER_DATA_PATH = path.join(process.cwd(), '..', '..', '.openclaw', 'workspace', 'goldhunter_data.json');\nconst LOG_FILE_PATH = 'C:\\\\Users\\\\hp\\\\AppData\\\\Roaming\\\\MetaQuotes\\\\Terminal\\\\Common\\\\Files\\\\GoldHunter_Log.csv';\n\nexport async function GET(request: NextRequest) {\n  try {\n    // Check if data file exists\n    if (!fs.existsSync(GOLDHUNTER_DATA_PATH)) {\n      return NextResponse.json({\n        success: false,\n        error: 'Data file not found',\n        path: GOLDHUNTER_DATA_PATH\n      }, { status: 404 });\n    }\n\n    // Read the data file\n    const data = JSON.parse(fs.readFileSync(GOLDHUNTER_DATA_PATH, 'utf-8'));\n    \n    // Check if log file exists\n    const logFileExists = fs.existsSync(LOG_FILE_PATH);\n    \n    return NextResponse.json({\n      success: true,\n      data: data,\n      metadata: {\n        logFileExists,\n        logFilePath: LOG_FILE_PATH,\n        lastUpdated: data.last_updated || new Date().toISOString(),\n        dataAge: data.last_updated \n          ? Math.floor((Date.now() - new Date(data.last_updated).getTime()) / 1000)\n          : null\n      }\n    });\n    \n  } catch (error: any) {\n    console.error('Error reading GoldHunter data:', error);\n    \n    return NextResponse.json({\n      success: false,\n      error: error.message,\n      path: GOLDHUNTER_DATA_PATH\n    }, { status: 500 });\n  }\n}\n\nexport async function POST(request: NextRequest) {\n  try {\n    // Trigger data update\n    const { spawn } = require('child_process');\n    const pythonScript = path.join(process.cwd(), '..', '..', '.openclaw', 'workspace', 'update_goldhunter_data.py');\n    \n    if (!fs.existsSync(pythonScript)) {\n      return NextResponse.json({\n        success: false,\n        error: 'Update script not found'\n      }, { status: 404 });\n    }\n    \n    // Run the update script\n    const pythonProcess = spawn('python', [pythonScript]);\n    \n    let output = '';\n    let errorOutput = '';\n    \n    pythonProcess.stdout.on('data', (data: Buffer) => {\n      output += data.toString();\n    });\n    \n    pythonProcess.stderr.on('data', (data: Buffer) => {\n      errorOutput += data.toString();\n    });\n    \n    return new Promise((resolve) => {\n      pythonProcess.on('close', (code: number) => {\n        if (code === 0) {\n          resolve(NextResponse.json({\n            success: true,\n            message: 'Data updated successfully',\n            output: output.trim()\n          }));\n        } else {\n          resolve(NextResponse.json({\n            success: false,\n            error: `Update failed with code ${code}`,\n            output: output.trim(),\n            errorOutput: errorOutput.trim()\n          }, { status: 500 }));\n        }\n      });\n    });\n    \n  } catch (error: any) {\n    console.error('Error updating GoldHunter data:', error);\n    \n    return NextResponse.json({\n      success: false,\n      error: error.message\n    }, { status: 500 });\n  }\n}"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":87,"output":838,"cacheRead":43392,"cacheWrite":0,"totalTokens":44317,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773989435992}}
