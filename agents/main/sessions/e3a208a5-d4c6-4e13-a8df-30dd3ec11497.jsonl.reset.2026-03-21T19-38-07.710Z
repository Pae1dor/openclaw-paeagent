  <div class=\"chart-box\"><canvas id=\"stockChart\"></canvas></div>\n  </div>\n</div>"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-sonnet-4-6","usage":{"input":1,"output":782,"cacheRead":82674,"cacheWrite":3352,"totalTokens":86809,"cost":{"input":0.000003,"output":0.01173,"cacheRead":0.0248022,"cacheWrite":0.01257,"total":0.0491052}},"stopReason":"toolUse","timestamp":1773994603637}}
