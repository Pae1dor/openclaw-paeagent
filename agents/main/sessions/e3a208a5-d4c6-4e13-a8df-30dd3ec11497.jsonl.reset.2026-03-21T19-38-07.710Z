{"type":"message","id":"2a932ab4","parentId":"30cc180a","timestamp":"2026-03-20T06:24:55.540Z","message":{"role":"assistant","content":[{"type":"text","text":"## 8. สร้าง script สำหรับอัพเดทข้อมูลอัตโนมัติ"},{"type":"toolCall","id":"call_00_DZW3K9GRB3pKk9R6xot7cmDr","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\update_goldhunter_data.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nอัพเดทข้อมูล GoldHunter สำหรับ dashboard\nรันทุก 5 นาทีเพื่ออัพเดทข้อมูลล่าสุด\n\"\"\"\n\nimport sys\nimport os\nsys.path.append(os.path.dirname(os.path.abspath(__file__)))\n\nfrom goldhunter_summary import (\n    read_goldhunter_log, \n    extract_trading_summary,\n    get_historical_data\n)\nimport json\nfrom datetime import datetime\n\ndef main():\n    print(f\"=== Updating GoldHunter Data - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} ===\")\n    \n    # Path ไฟล์ log\n    log_path = r\"C:\\Users\\hp\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files\\GoldHunter_Log.csv\"\n    \n    if not os.path.exists(log_path):\n        print(f\"❌ File not found: {log_path}\")\n        return\n    \n    # อ่านข้อมูล\n    df = read_goldhunter_log(log_path)\n    if df is None or df.empty:\n        print(\"❌ No data in log file\")\n        return\n    \n    # สรุปผลวันนี้\n    today_summary = extract_trading_summary(df)\n    \n    if not today_summary:\n        print(\"❌ No trading summary for today\")\n        return\n    \n    print(f\"✅ Today's Summary: {today_summary['total_trades']} trades, P&L: ${today_summary['profit_loss']:,.2f}\")\n    \n    # ดึงข้อมูลย้อนหลัง\n    historical = get_historical_data(df, days=30)\n    \n    # สร้างข้อมูลสำหรับ dashboard\n    output_data = {\n        'summary': today_summary,\n        'historical': historical,\n        'raw_stats': {\n            'total_records': len(df),\n            'date_range': {\n                'start': df['DateTime'].min().strftime('%Y-%m-%d %H:%M:%S'),\n                'end': df['DateTime'].max().strftime('%Y-%m-%d %H:%M:%S')\n            }\n        },\n        'last_updated': datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n    }\n    \n    # บันทึกไฟล์ JSON\n    output_path = os.path.join(os.path.dirname(__file__), \"goldhunter_data.json\")\n    with open(output_path, 'w', encoding='utf-8') as f:\n        json.dump(output_data, f, indent=2, ensure_ascii=False)\n    \n    print(f\"✅ Data saved to: {output_path}\")\n    print(f\"✅ Historical data: {len(historical)} days\")\n\nif __name__ == \"__main__\":\n    main()"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":86,"output":692,"cacheRead":26688,"cacheWrite":0,"totalTokens":27466,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773987880023}}
