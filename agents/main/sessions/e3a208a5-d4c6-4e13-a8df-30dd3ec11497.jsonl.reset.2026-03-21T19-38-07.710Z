e: 0,\n+ 40     equity: 0,\n+ 41     win_rate: 0,\n+ 42     strategy: 'UNKNOWN',\n+ 43     last_update: new Date().toISOString(),\n+ 44     tag: 'NO_DATA',\n+ 45     message: 'Waiting for data from GoldHunter EA'\n+ 46   };\n+ 47   \n+ 48   const historical = tradingData?.historical || [];\n+ 49   const lastUpdated = tradingData?.last_updated || new Date().toISOString();\n   7   return (\n   8     <div className=\"flex flex-col gap-6\">\n   9       <DashboardHeader\n  10         title=\"Gold Trading Dashboard\"\n     ...","firstChangedLine":4},"isError":false,"timestamp":1773989504191}}
{"type":"message","id":"c03059a8","parentId":"adde03e5","timestamp":"2026-03-20T06:53:20.795Z","message":{"role":"assistant","content":[{"type":"text","text":"ต้องสร้าง client component สำหรับ interactive parts"},{"type":"toolCall","id":"call_00_C05UiGs0e9itpPmK20jnVqu3","name":"write","arguments":{"path":"C:\\Users\\hp\\Desktop\\clawd\\app\\gold-trading\\GoldTradingClient.tsx","content":"'use client';\n\nimport { useState, useEffect } from 'react';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport { Button } from '@/components/ui/button';\nimport { BarChart3, TrendingUp, DollarSign, Target, PieChart, History, RefreshCw, AlertCircle, Loader2 } from 'lucide-react';\nimport { toast } from 'sonner';\n\ninterface TradingData {\n  summary: {\n    date: string;\n    total_trades: number;\n    wins: number;\n    losses: number;\n    profit_loss: number;\n    balance: number;\n    equity: number;\n    win_rate: number;\n    strategy: string;\n    last_update: string;\n    tag: string;\n    message: string;\n  };\n  historical: any[];\n  last_updated: string;\n}\n\ninterface GoldTradingClientProps {\n  initialData: TradingData | null;\n  error: string | null;\n}\n\nexport default function GoldTradingClient({ initialData, error }: GoldTradingClientProps) {\n  const [tradingData, setTradingData] = useState<TradingData | null>(initialData);\n  const [isLoading, setIsLoading] = useState(false);\n  const [lastUpdateTime, setLastUpdateTime] = useState<string>(initialData?.last_updated || new Date().toISOString());\n  \n  const summary = tradingData?.summary || {\n    date: new Date().toISOString().split('T')[0],\n    total_trades: 0,\n    wins: 0,\n    losses: 0,\n    profit_loss: 0,\n    balance: 0,\n    equity: 0,\n    win_rate: 0,\n    strategy: 'UNKNOWN',\n    last_update: new Date().toISOString(),\n    tag: 'NO_DATA',\n    message: 'Waiting for data from GoldHunter EA'\n  };\n  \n  const historical = tradingData?.historical || [];\n  \n  const fetchData = async () => {\n    setIsLoading(true);\n    try {\n      const response = await fetch('/api/gold-trading');\n      const result = await response.json();\n      \n      if (result.success) {\n        setTradingData(result.data);\n        setLastUpdateTime(result.data.last_updated);\n        toast.success('Data updated successfully');\n      } else {\n        toast.error(`Failed to load data: ${result.error}`);\n      }\n    } catch (err: any) {\n      toast.error(`Error: ${err.message}`);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n  \n  const updateData = async () => {\n    setIsLoading(true);\n    try {\n      const response = await fetch('/api/gold-trading', {\n        method: 'POST'\n      });\n      const result = await response.json();\n      \n      if (result.success) {\n        toast.success('Data update triggered');\n        // Wait a bit then refresh data\n        setTimeout(fetchData, 2000);\n      } else {\n        toast.error(`Update failed: ${result.error}`);\n        setIsLoading(false);\n      }\n    } catch (err: any) {\n      toast.error(`Error: ${err.message}`);\n      setIsLoading(false);\n    }\n  };\n  \n  // Auto-refresh every 30 seconds\n  useEffect(() => {\n    const interval = setInterval(fetchData, 30000);\n    return () => clearInterval(interval);\n  }, []);\n  \n  const formatCurrency = (value: number) => {\n    return new Intl.NumberFormat('en-US', {\n      style: 'currency',\n      currency: 'USD',\n      minimumFractionDigits: 2\n    }).format(value);\n  };\n  \n  const formatPercent = (value: number) => {\n    return `${value.toFixed(1)}%`;\n  };\n  \n  const getPLColor = (value: number) => {\n    return value >= 0 ? 'text-green-600' : 'text-red-600';\n  };\n  \n  const getPLSign = (value: number) => {\n    return value >= 0 ? '+' : '';\n  };\n  \n  if (error && !tradingData) {\n    return (\n      <div className=\"flex flex-col items-center justify-center h-96 gap-4\">\n        <AlertCircle className=\"h-12 w-12 text-red-500\" />\n        <div className=\"text-center\">\n          <h3 className=\"text-lg font-semibold\">Failed to load trading data</h3>\n          <p className=\"text-muted-foreground mt-2\">{error}</p>\n          <Button onClick={fetchData} className=\"mt-4\">\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Retry\n          </Button>\n        </div>\n      </div>\n    );\n  }\n  \n  return (\n    <div className=\"flex flex-col gap-6\">\n      {/* Header with refresh button */}\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold tracking-tight\">Gold Trading Dashboard</h1>\n          <p className=\"text-muted-foreground\">\n            ติดตามผลการเทรด GoldHunter EA บน MT5 (XAUUSD)\n            {lastUpdateTime && (\n              <span className=\"ml-2 text-sm\">\n                • อัพเดทล่าสุด: {new Date(lastUpdateTime).toLocaleString('th-TH')}\n              </span>\n            )}\n          </p>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button \n            variant=\"outline\" \n            size=\"sm\" \n            onClick={fetchData}\n            disabled={isLoading}\n          >\n            {isLoading ? (\n              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n            ) : (\n              <RefreshCw className=\"h-4 w-4 mr-2\" />\n            )}\n            Refresh\n          </Button>\n          <Button \n            size=\"sm\" \n            onClick={updateData}\n            disabled={isLoading}\n          >\n            {isLoading ? (\n              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n            ) : (\n              <RefreshCw className=\"h-4 w-4 mr-2\" />\n            )}\n            Update Data\n          </Button>\n        </div>\n      </div>\n      \n      {/* Summary Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <Card>\n          <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n            <CardTitle className=\"text-sm font-medium\">Today's P&L</CardTitle>\n            <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n          </CardHeader>\n          <CardContent>\n            <div className={`text-2xl font-bold ${getPLColor(summary.profit_loss)}`}>\n              {getPLSign(summary.profit_loss)}{formatCurrency(summary.profit_loss)}\n            </div>\n            <p className=\"text-xs text-muted-foreground\">\n              {summary.total_trades > 0 ? `${summary.wins} wins, ${summary.losses} losses` : 'No trades today'}\n            </p>\n          </CardContent>\n        </Card>\n        \n        <Card>\n          <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n            <CardTitle className=\"text-sm font-medium\">Total Trades</CardTitle>\n            <Target className=\"h-4 w-4 text-muted-foreground\" />\n          </CardHeader>\n          <CardContent>\n            <div className=\"text-2xl font-bold\">{summary.total_trades}</div>\n            <p className=\"text-xs text-muted-foreground\">\n              Today • {summary.wins}W {summary.losses}L\n            </p>\n          </CardContent>\n        </Card>\n        \n        <Card>\n          <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n            <CardTitle className=\"text-sm font-medium\">Win Rate</CardTitle>\n            <TrendingUp className=\"h-4 w-4 text-muted-foreground\" />\n          </CardHeader>\n          <CardContent>\n            <div className=\"text-2xl font-bold\">{formatPercent(summary.win_rate)}</div>\n            <p className=\"text-xs text-muted-foreground\">\n              {summary.win_rate >= 60 ? 'Above target' : 'Below target'}\n            </p>\n          </CardContent>\n        </Card>\n        \n        <Card>\n          <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n            <CardTitle className=\"text-sm font-medium\">Balance</CardTitle>\n            <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\n          </CardHeader>\n          <CardContent>\n            <div className=\"text-2xl font-bold\">{formatCurrency(summary.balance)}</div>\n            <p className=\"text-xs text-muted-foreground\">\n              Equity: {formatCurrency(summary.equity)}\n            </p>\n          </CardContent>\n        </Card>\n      </div>\n      \n      {/* Status Card */}\n      <Card className={summary.tag === 'NO_DATA' ? 'bg-amber-50 border-amber-200' : ''}>\n        <CardHeader className=\"pb-3\">\n          <CardTitle className=\"text-sm flex items-center gap-2\">\n            {summary.tag === 'NO_DATA' ? (\n              <AlertCircle className=\"h-4 w-4 text-amber-600\" />\n            ) : null}\n            Current Status\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <p className=\"font-medium\">{summary.tag}</p>\n              <p className=\"text-sm text-muted-foreground\">{summary.message}</p>\n            </div>\n            <div className=\"text-right\">\n              <p className=\"font-medium\">Strategy: {summary.strategy}</p>\n              <p className=\"text-sm text-muted-foreground\">Last update: {new Date(summary.last_update).toLocaleTimeString('th-TH')}</p>\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n      \n      {/* Main Tabs */}\n      <Tabs defaultValue=\"overview\" className=\"space-y-4\">\n        <TabsList>\n          <TabsTrigger value=\"overview\">\n            <BarChart3 className=\"h-4 w-4 mr-2\" />\n            Overview\n          </TabsTrigger>\n          <TabsTrigger value=\"performance\">\n            <TrendingUp className=\"h-4 w-4 mr-2\" />\n            Performance\n          </TabsTrigger>\n          <TabsTrigger value=\"strategies\">\n            <PieChart className=\"h-4 w-4 mr-2\" />\n            Strategies\n          </TabsTrigger>\n          <TabsTrigger value=\"history\">\n            <History className=\"h-4 w-4 mr-2\" />\n            History\n          </TabsTrigger>\n        </TabsList>\n        \n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Equity Curve</CardTitle>\n              <CardDescription>Balance progression over time</CardDescription>\n            </CardHeader>\n            <CardContent className=\"h-80\">\n              {historical.length > 0 ? (\n                <div className=\"flex items-center justify-center h-full border rounded-lg bg-muted/20\">\n                  <div className=\"text-center\">\n                    <p className=\"font-medium\">{historical.length} days of data</p>\n                    <p className=\"text-sm text-muted-foreground mt-2\">\n                      Starting balance: {formatCurrency(historical[0]?.balance || 100000)}\n                    </p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Current balance: {formatCurrency(summary.balance)}\n                    </p>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"flex items-center justify-center h-full border rounded-lg bg-muted/20\">\n                  <p className=\"text-muted-foreground\">No historical data available yet</p>\n                </div>\n              )}\n            </CardContent>\n          </Card>\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Daily P&L</CardTitle>\n                <CardDescription>Profit/Loss per day</CardDescription>\n              </CardHeader>\n              <CardContent className=\"h-64\">\n                {historical.length > 0 ? (\n                  <div className=\"flex items-center justify-center h-full border rounded-lg bg-muted/20\">\n                    <div className=\"text-center\">\n                      <p className=\"font-medium\">{historical.filter((d: any) => d.pl !== undefined).length} days with P&L data</p>\n                      <p className=\"text-sm text-muted-foreground mt-2\">\n                        Best day: {formatCurrency(Math.max(...historical.map((d: any) => d.pl || 0)))}\n                      </p>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Worst day: {formatCurrency(Math.min(...historical.map((d: any) => d.pl || 0)))}\n                      </p>\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"flex items-center justify-center h-full border rounded-lg bg-muted/20\">\n                    <p className=\"text-muted-foreground\">No P&L data available</p>\n                  </div>\n                )}\n              </CardContent>\n            </Card>\n            \n            <Card>\n              <CardHeader>\n                <CardTitle>Strategy Distribution</CardTitle>\n                <CardDescription>Trades by strategy type</CardDescription>\n              </CardHeader>\n              <CardContent className=\"h-64\">\n                <div className=\"flex items-center justify-center h-full border rounded-lg bg-muted/20\">\n                  <div className=\"text-center\">\n                    <p className=\"font-medium\">Current: {summary.strategy}</p>\n                    <div className=\"flex gap-2 mt-4 justify-center\">\n                      <span className=\"px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm\">SCALP</span>\n                      <span className=\"px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm\">TREND</span>\n                      <span className=\"px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm\">BREAKOUT</span>\n                    </div>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n        \n        <TabsContent value=\"performance\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Performance Metrics</CardTitle>\n              <CardDescription>Detailed trading performance analysis</CardDescription>\n            </CardHeader>\n            <CardContent>\n              {summary.total_trades > 0 ? (\n                <div className=\"space-y-4\">\n                  <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                    <div className=\"space-y-1\">\n                      <p className=\"text-sm font-medium\">Profit Factor</p>\n                      <p className=\"text-2xl font-bold\">\n                        {summary.wins > 0 && summary.losses > 0 \n                          ? (summary.wins / summary.losses).toFixed(2)\n                          : 'N/A'}\n                      </p>\n                    </div>\n                    <div className=\"space-y-1\">\n                      <p className=\"text-sm font-medium\">Avg Win</p>\n                      <p className=\"text-2xl font-bold text-green-600\">\n                        {summary.wins > 0 \n                          ? formatCurrency(summary.profit_loss > 0 ? summary.profit_loss / summary.wins : 0)\n                          : '$0.00'}\n                      </p>\n                    </div>\n                    <div className=\"space-y-1\">\n                      <p className=\"text-sm font-medium\">Avg Loss</p>\n                      <p className=\"text-2xl font-bold text-red-600\">\n                        {summary.losses > 0 \n                          ? formatCurrency(summary.profit_loss < 0 ? Math.abs(summary.profit_loss) / summary.losses :