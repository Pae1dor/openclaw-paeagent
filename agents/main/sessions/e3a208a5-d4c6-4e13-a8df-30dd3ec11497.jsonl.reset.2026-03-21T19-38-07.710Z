{"type":"message","id":"3d180a95","parentId":"8f4c798e","timestamp":"2026-03-20T06:27:10.261Z","message":{"role":"assistant","content":[{"type":"text","text":"ได้สิ! มาทำให้ dashboard รันบน localhost:3000\n\nต้องสร้าง server แบบง่ายๆ ด้วย Python หรือ Node.js มาทำด้วย Python Flask กัน"},{"type":"toolCall","id":"call_00_p9o28DdZq889TMfjba6KSBst","name":"write","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\app.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nGoldHunter Dashboard Server\nรันบน localhost:3000\n\"\"\"\n\nfrom flask import Flask, render_template, send_file, jsonify\nimport os\nimport json\nfrom datetime import datetime\nimport threading\nimport time\n\napp = Flask(__name__, static_folder='.', static_url_path='')\n\n# Path ไฟล์ต่างๆ\nLOG_PATH = r\"C:\\Users\\hp\\AppData\\Roaming\\MetaQuotes\\Terminal\\Common\\Files\\GoldHunter_Log.csv\"\nDATA_FILE = os.path.join(os.path.dirname(__file__), \"goldhunter_data.json\")\nDASHBOARD_FILE = os.path.join(os.path.dirname(__file__), \"dashboard_goldhunter.html\")\n\n# ตัวแปรเก็บข้อมูลล่าสุด\nlatest_data = None\nlast_update = None\n\ndef load_data():\n    \"\"\"โหลดข้อมูลจากไฟล์ JSON\"\"\"\n    global latest_data, last_update\n    \n    try:\n        if os.path.exists(DATA_FILE):\n            with open(DATA_FILE, 'r', encoding='utf-8') as f:\n                latest_data = json.load(f)\n                last_update = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n                print(f\"✅ Data loaded: {last_update}\")\n        else:\n            print(\"⚠️ Data file not found, creating empty data\")\n            latest_data = {\n                'summary': {\n                    'date': datetime.now().strftime('%Y-%m-%d'),\n                    'total_trades': 0,\n                    'wins': 0,\n                    'losses': 0,\n                    'profit_loss': 0.0,\n                    'balance': 0.0,\n                    'equity': 0.0,\n                    'win_rate': 0.0,\n                    'strategy': 'UNKNOWN',\n                    'last_update': '',\n                    'tag': '',\n                    'message': 'No data available'\n                },\n                'historical': [],\n                'last_updated': datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n            }\n    except Exception as e:\n        print(f\"❌ Error loading data: {e}\")\n        latest_data = None\n\ndef auto_update_data():\n    \"\"\"อัพเดทข้อมูลทุก 30 วินาที\"\"\"\n    while True:\n        try:\n            # อัพเดทข้อมูล\n            from update_goldhunter_data import main as update_main\n            print(\"🔄 Auto-updating data...\")\n            update_main()\n            load_data()\n        except Exception as e:\n            print(f\"❌ Auto-update error: {e}\")\n        \n        # รอ 30 วินาที\n        time.sleep(30)\n\n@app.route('/')\ndef index():\n    \"\"\"หน้า dashboard หลัก\"\"\"\n    return send_file(DASHBOARD_FILE)\n\n@app.route('/api/data')\ndef get_data():\n    \"\"\"API สำหรับดึงข้อมูล\"\"\"\n    if latest_data is None:\n        load_data()\n    \n    if latest_data:\n        return jsonify({\n            'success': True,\n            'data': latest_data,\n            'last_updated': last_update,\n            'server_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n        })\n    else:\n        return jsonify({\n            'success': False,\n            'error': 'No data available',\n            'server_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n        })\n\n@app.route('/api/update')\ndef update_data():\n    \"\"\"API สำหรับอัพเดทข้อมูล manual\"\"\"\n    try:\n        from update_goldhunter_data import main as update_main\n        update_main()\n        load_data()\n        \n        return jsonify({\n            'success': True,\n            'message': 'Data updated successfully',\n            'last_updated': last_update\n        })\n    except Exception as e:\n        return jsonify({\n            'success': False,\n            'error': str(e)\n        })\n\n@app.route('/api/summary')\ndef get_summary():\n    \"\"\"API สำหรับดึงสรุปผลล่าสุด\"\"\"\n    if latest_data is None:\n        load_data()\n    \n    if latest_data and 'summary' in latest_data:\n        return jsonify({\n            'success': True,\n            'summary': latest_data['summary'],\n            'last_updated': last_update\n        })\n    else:\n        return jsonify({\n            'success': False,\n            'error': 'No summary available'\n        })\n\n@app.route('/api/health')\ndef health_check():\n    \"\"\"Health check endpoint\"\"\"\n    return jsonify({\n        'status': 'healthy',\n        'service': 'GoldHunter Dashboard',\n        'version': '1.0.0',\n        'timestamp': datetime.now().isoformat(),\n        'data_available': latest_data is not None,\n        'last_update': last_update\n    })\n\n@app.route('/dashboard')\ndef dashboard():\n    \"\"\"Alias สำหรับ dashboard\"\"\"\n    return send_file(DASHBOARD_FILE)\n\n@app.route('/goldhunter')\ndef goldhunter():\n    \"\"\"Alias อีกชื่อ\"\"\"\n    return send_file(DASHBOARD_FILE)\n\nif __name__ == '__main__':\n    # โหลดข้อมูลครั้งแรก\n    print(\"🚀 Starting GoldHunter Dashboard Server...\")\n    print(f\"📁 Data file: {DATA_FILE}\")\n    print(f\"📁 Log file: {LOG_PATH}\")\n    \n    load_data()\n    \n    # เริ่ม thread auto-update\n    update_thread = threading.Thread(target=auto_update_data, daemon=True)\n    update_thread.start()\n    \n    print(\"✅ Server ready!\")\n    print(\"🌐 Open: http://localhost:3000\")\n    print(\"📊 Dashboard: http://localhost:3000/dashboard\")\n    print(\"📈 API Data: http://localhost:3000/api/data\")\n    print(\"🔄 Manual Update: http://localhost:3000/api/update\")\n    print(\"❤️ Health Check: http://localhost:3000/api/health\")\n    \n    # รัน server\n    app.run(host='0.0.0.0', port=3000, debug=False)"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":129,"output":1406,"cacheRead":29440,"cacheWrite":0,"totalTokens":30975,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773988000601}}
