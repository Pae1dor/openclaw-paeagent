{"type":"message","id":"fc851ebb","parentId":"7e0a4234","timestamp":"2026-03-20T06:27:34.691Z","message":{"role":"assistant","content":[{"type":"text","text":"## 14. อัพเดท dashboard script ให้ใช้ API"},{"type":"toolCall","id":"call_00_oDna1h6945pZ6pP2pJUIyr15","name":"edit","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\dashboard_script.js","oldText":"// โหลดข้อมูลจาก API\nasync function loadData() {\n    const loadingEl = document.getElementById('lastUpdate');\n    loadingEl.textContent = 'กำลังโหลดข้อมูล...';\n    loadingEl.style.color = '#ffd166';\n    \n    try {\n        // โหลดข้อมูลจากไฟล์ JSON\n        const response = await fetch('goldhunter_data.json');\n        \n        if (!response.ok) {\n            throw new Error(`HTTP error! status: ${response.status}`);\n        }\n        \n        tradingData = await response.json();\n        \n        // อัพเดท UI\n        updateDashboard();\n        \n        // อัพเดทเวลาล่าสุด\n        const now = new Date();\n        document.getElementById('lastUpdate').textContent = \n            `อัพเดทล่าสุด: ${now.toLocaleString('th-TH')}`;\n        document.getElementById('lastUpdate').style.color = '#06d6a0';\n        \n    } catch (error) {\n        console.error('Error loading data:', error);\n        document.getElementById('lastUpdate').textContent = \n            '❌ ไม่สามารถโหลดข้อมูลได้: ' + error.message;\n        document.getElementById('lastUpdate').style.color = '#ef476f';\n    }\n}","newText":"// โหลดข้อมูลจาก API\nasync function loadData() {\n    const loadingEl = document.getElementById('lastUpdate');\n    loadingEl.textContent = 'กำลังโหลดข้อมูล...';\n    loadingEl.style.color = '#ffd166';\n    \n    try {\n        // โหลดข้อมูลจาก API\n        const response = await fetch('/api/data');\n        \n        if (!response.ok) {\n            throw new Error(`HTTP error! status: ${response.status}`);\n        }\n        \n        const result = await response.json();\n        \n        if (!result.success) {\n            throw new Error(result.error || 'Failed to load data');\n        }\n        \n        tradingData = result.data;\n        \n        // อัพเดท UI\n        updateDashboard();\n        \n        // อัพเดทเวลาล่าสุด\n        const now = new Date();\n        const serverTime = result.server_time || now.toISOString();\n        document.getElementById('lastUpdate').textContent = \n            `อัพเดทล่าสุด: ${new Date(serverTime).toLocaleString('th-TH')}`;\n        document.getElementById('lastUpdate').style.color = '#06d6a0';\n        \n    } catch (error) {\n        console.error('Error loading data:', error);\n        document.getElementById('lastUpdate').textContent = \n            '❌ ไม่สามารถโหลดข้อมูลได้: ' + error.message;\n        document.getElementById('lastUpdate').style.color = '#ef476f';\n        \n        // ลองโหลดจากไฟล์ JSON โดยตรงถ้า API ล้มเหลว\n        try {\n            const fallbackResponse = await fetch('goldhunter_data.json');\n            if (fallbackResponse.ok) {\n                tradingData = await fallbackResponse.json();\n                updateDashboard();\n                document.getElementById('lastUpdate').textContent = \n                    '⚠️ ใช้ข้อมูลจากไฟล์สำรอง (API ล้มเหลว)';\n                document.getElementById('lastUpdate').style.color = '#ffd166';\n            }\n        } catch (fallbackError) {\n            console.error('Fallback also failed:', fallbackError);\n        }\n    }\n}"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":59,"output":795,"cacheRead":31168,"cacheWrite":0,"totalTokens":32022,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773988037058}}
