,\n      \"state\": {\n        \"nextRunAtMs\": 1774018800000\n      }\n    },\n    {\n      \"id\": \"9f836c57-7824-443e-a26a-4801a332775a\",\n      \"agentId\": \"main\",\n      \"sessionKey\": \"agent:main:main\",\n      \"name\": \"GoldHunter Daily Summary\",\n      \"enabled\": true,\n      \"createdAtMs\": 1773911874843,\n      \"updatedAtMs\": 1773932439721,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 22 * * *\",\n        \"tz\": \"Asia/Bangkok\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"สรุปผลเทรดทองวันนี้จากไฟล์ GoldHunter Log:\\n\\n1. หา CSV ไฟล์ล่าสุดใน C:\\\\Users\\\\hp\\\\AppData\\\\Roaming\\\\MetaQuotes\\\\Terminal\\\\Common\\\\Files\\\\ ที่ชื่อขึ้นต้นด้วย GoldHunter_Log โดยใช้ PowerShell: Get-ChildItem 'C:\\\\Users\\\\hp\\\\AppData\\\\Roaming\\\\MetaQuotes\\\\Terminal\\\\Common\\\\Files\\\\GoldHunter_Log*.csv' | Sort-Object LastWriteTime -Descending | Select-Object -First 1\\n\\n2. อ่าน CSV ไฟล์นั้น\\n\\n3. กรองเฉพาะ trades ของวันนี้ (วันที่ปัจจุบัน timezone Asia/Bangkok)\\n\\n4. คำนวณ:\\n   - จำนวน orders ทั้งหมดวันนี้\\n   - กำไร/ขาดทุนรวม (net P&L)\\n   - Win rate (% orders ที่กำไร)\\n   - Best trade และ Worst trade\\n\\n5. ส่งสรุปไปที่ Telegram user 8631446075 ผ่าน sessions_send โดยหา session ที่เป็น Telegram ก่อนด้วย sessions_list\\n\\nถ้าไม่พบไฟล์หรือไม่มี trade วันนี้ ให้แจ้งว่าไม่พบข้อมูล\\n\\nFormat ข้อความที่ส่ง:\\n📊 *GoldHunter สรุปวันนี้*\\n📅 วันที่: [date]\\n\\n📋 Orders: [จำนวน]\\n💰 Net P&L: [+/-amount]\\n🎯 Win Rate: [%]\\n🏆 Best: [amount]\\n💀 Worst: [amount]\\n\\n[ประเมินสั้นๆ 1 บรรทัด]\",\n        \"timeoutSeconds\": 120\n      },\n      \"delivery\": {\n        \"mode\": \"announce\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1774018800000,\n        \"lastRunAtMs\": 1773932400028,\n        \"lastRunStatus\": \"error\",\n        \"lastStatus\": \"error\",\n        \"lastDurationMs\": 39693,\n        \"lastError\": \"Delivering to Telegram requires target <chatId>\",\n        \"lastDeliveryStatus\": \"unknown\",\n        \"consecutiveErrors\": 1\n      }\n    },\n    {\n      \"id\": \"6c21bf6f-20d3-4a52-958b-9e6365d3ae24\",\n      \"name\": \"morning-stock-news\",\n      \"description\": \"สรุปข่าวหุ้นเช้า ส่ง Telegram ทุกวัน 8 โมง\",\n      \"enabled\": true,\n      \"createdAtMs\": 1773903770613,\n      \"updatedAtMs\": 1773978143643,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 8 * * *\",\n        \"tz\": \"Asia/Bangkok\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"ค้นหาข่าวหุ้นไทยและต่างประเทศที่สำคัญของวันนี้ สรุปเป็นภาษาไทยแบบกระชับ ครอบคลุม SET, ดาวโจนส์, นาสแดค, ราคาทอง, และประเด็นเด่นที่กระทบตลาด พร้อมบอกทิศทางแนวโน้มสั้นๆ\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"last\",\n        \"to\": \"telegram:8631446075\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1774054800000,\n        \"lastRunAtMs\": 1773978119227,\n        \"lastRunStatus\": \"error\",\n        \"lastStatus\": \"error\",\n        \"lastDurationMs\": 24416,\n        \"lastError\": \"HttpError: Network request for 'sendMessage' failed!\",\n        \"lastDeliveryStatus\": \"unknown\",\n        \"consecutiveErrors\": 1\n      }\n    }\n  ],\n  \"total\": 4,\n  \"offset\": 0,\n  \"limit\": 4,\n  \"hasMore\": false,\n  \"nextOffset\": null\n}"}],"details":{"jobs":[{"id":"be149b1e-02a4-4bc5-aab1-88c19dd428c3","agentId":"main","sessionKey":"agent:main:main","name":"GoldHunter Data Update","enabled":true,"createdAtMs":1773987900845,"updatedAtMs":1773987900845,"schedule":{"kind":"every","everyMs":300000,"anchorMs":1773987900845},"sessionTarget":"isolated","wakeMode":"now","payload":{"kind":"agentTurn","message":"Update GoldHunter trading data for dashboard. Run the update_