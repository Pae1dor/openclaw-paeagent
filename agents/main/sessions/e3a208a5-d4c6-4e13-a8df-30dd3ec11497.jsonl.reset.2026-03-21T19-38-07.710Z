{"type":"message","id":"f11eb6e1","parentId":"ecc7e1fe","timestamp":"2026-03-20T08:39:27.657Z","message":{"role":"assistant","content":[{"type":"text","text":"ตอนนี้เพิ่มฟังก์ชันสร้าง mini charts ใน JS:"},{"type":"toolCall","id":"call_00_0x0Nni8UZZbkvUjdVmhOLI6Y","name":"edit","arguments":{"path":"C:\\Users\\hp\\.openclaw\\workspace\\dashboard\\public\\index.html","old_string":"  updateTime();\n}","new_string":"  updateTime();\n  renderMiniCharts();\n}\n\nfunction renderMiniCharts() {\n  const container = document.getElementById('miniCharts');\n  if (!container) return;\n  container.innerHTML = portfolio.map((s,i) => {\n    // สร้าง mock data 7 วัน\n    const base = s.value / (1 + s.pct/100);\n    const days = 7;\n    const data = Array.from({length:days}, (_,j) => {\n      const dayOffset = days - j - 1;\n      const noise = (Math.random()-0.5) * s.value * 0.02;\n      return base * (1 + (s.pct/100)*(j/(days-1))) + noise;\n    });\n    const last = data[data.length-1];\n    const first = data[0];\n    const change = ((last - first) / first * 100).toFixed(2);\n    const canvasId = `miniChart${i}`;\n    return `\n      <div style=\"background:rgba(255,255,255,0.03);border-radius:10px;padding:14px;border:1px solid rgba(255,255,255,0.08)\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px\">\n          <div style=\"font-weight:600;color:#4ecdc4\">${s.ticker}</div>\n          <div class=\"${parseFloat(change)>=0?'up':'down'}\" style=\"font-size:.85rem;font-weight:600\">\n            ${parseFloat(change)>=0?'▲':'▼'} ${Math.abs(parseFloat(change)).toFixed(2)}%\n          </div>\n        </div>\n        <div style=\"height:80px;position:relative\">\n          <canvas id=\"${canvasId}\"></canvas>\n        </div>\n        <div style=\"display:flex;justify-content:space-between;font-size:.75rem;opacity:.6;margin-top:6px\">\n          <span>$${first.toFixed(2)}</span>\n          <span>$${last.toFixed(2)}</span>\n        </div>\n      </div>`;\n  }).join('');\n\n  // วาดกราฟ\n  portfolio.forEach((s,i) => {\n    const canvas = document.getElementById(`miniChart${i}`);\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    const base = s.value / (1 + s.pct/100);\n    const days = 7;\n    const data = Array.from({length:days}, (_,j) => {\n      const dayOffset = days - j - 1;\n      const noise = (Math.random()-0.5) * s.value * 0.02;\n      return base * (1 + (s.pct/100)*(j/(days-1))) + noise;\n    });\n    const isUp = s.pct >= 0;\n    new Chart(ctx, {\n      type: 'line',\n      data: {\n        labels: Array.from({length:days}, (_,j) => `${j+1}D`),\n        datasets: [{\n          data,\n          borderColor: isUp ? '#06d6a0' : '#ef476f',\n          backgroundColor: isUp ? 'rgba(6,214,160,0.1)' : 'rgba(239,71,111,0.1)',\n          borderWidth: 2,\n          tension: 0.3,\n          fill: true,\n          pointRadius: 0\n        }]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false } },\n        scales: {\n          x: { display: false },\n          y: { display: false }\n        }\n      }\n    });\n  });\n}"}}],"api":"openai-completions","provider":"custom-api-deepseek-com","model":"deepseek-chat","usage":{"input":46,"output":942,"cacheRead":38272,"cacheWrite":0,"totalTokens":39260,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773995913810}}
